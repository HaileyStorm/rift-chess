def view_dot(vertex: Vertex, camera: Camera.Basis) -> F32:
  match vertex camera:
    case Vertex{+file, +row, +height} Camera.Basis{cosYaw, sinYaw, sinPitch, +cosPitch, scale, cx, cy}:
      F32.add(F32.mul(cosPitch, F32.add(F32.mul(file, sinYaw), F32.mul(row, cosYaw))),
        F32.mul(height, sinPitch))

def project(vertex: Vertex, +size: U32, camera: Camera.Basis) -> Quad.Point:
  match vertex camera:
    case Vertex{+file, +row, height}
        Camera.Basis{+cosYaw, +sinYaw, sinPitch, cosPitch, scale, cx, cy}:
      +span = F32.add(F32.abs(cosYaw), F32.abs(sinYaw))
      +x = F32.div(F32.sub(F32.mul(cosYaw, file), F32.mul(sinYaw, row)), span)
      +y = F32.div(F32.sub(F32.mul(sinPitch,
        F32.add(F32.mul(sinYaw, file), F32.mul(cosYaw, row))),
        F32.mul(cosPitch, height)), span)
      Quad.Point{F32.mul(U32.to_f32(size), F32.div(F32.add(x, frame_left()), frame_width())),
        F32.mul(U32.to_f32(size), F32.div(F32.add(y, frame_top()), frame_height()))}

# A single fixed directional light shades every body and metal face.
# Signed diffuse gives dark side planes; the upper-facing glint is restrained.
def light(normal: Vertex) -> F32:
  match normal:
    case Vertex{file, row, height}:
      F32.add(F32.add(F32.mul(file, F32.neg(0.45)),
        F32.mul(row, F32.neg(0.55))), F32.mul(height, 0.75))

def diffuse(+value: F32) -> U32:
  F32.to_u32(F32.min(255.0, F32.max(0.0,
    F32.add(140.0, F32.mul(116.0, value)))))

def highlight(value: F32) -> U32:
  F32.to_u32(F32.mul(F32.max(0.0, value), 90.0))

def body_ink(+normal: Vertex, body: U32, glint: U32, shadow: U32) -> U32:
  +value = light(normal)
  Color.over(glint, Color.over(body, shadow, diffuse(value)), highlight(value))

def ink(band: U32, +normal: Vertex, style: PieceArt.Material) -> U32:
  match band style:
    case 0 PieceArt.Material{body, shade, glint, shadow}:
      body_ink(normal, body, glint, shadow)
    case 1 PieceArt.Material{body, shade, glint, shadow}:
      body_ink(normal, 11499576, 16244390, 6173718)
    case _ _: 463386

def prepare_case(visible: Bool, face: Face, +camera: Camera.Basis,
  +size: U32, style: PieceArt.Material) -> Maybe<Painted>:
  match visible face:
    case False{} _: None{}
    case True{} Face{a, b, c, d, normal, middle, band}:
      Some{Painted{Quad.make(project(a, size, camera), project(b, size, camera),
        project(c, size, camera), project(d, size, camera)),
        ink(band, normal, style), view_dot(middle, camera)}}

def prepare(+face: Face, +camera: Camera.Basis,
  size: U32, style: PieceArt.Material) -> Maybe<Painted>:
  match face:
    case Face{a, b, c, d, normal, middle, band}:
      prepare_case(F32.is_gt(view_dot(normal, camera), 0.00001), face,
        camera, size, style)

def prepared_next(next: Maybe<Painted>, rest: List<&2, Painted>) -> List<&2, Painted>:
  match next:
    case None{}: rest
    case Some{face}: face <> rest

def prepared(mesh: List<&2, Face>, +camera: Camera.Basis,
  +size: U32, +style: PieceArt.Material) -> List<&2, Painted>:
  match mesh:
    case Nil{}: Nil{}
    case face <> rest:
      prepared_next(prepare(face, camera, size, style), prepared(rest, camera, size, style))

def painted_le(a: Painted, b: Painted) -> Bool:
  match a b:
    case Painted{q1, c1, +d1} Painted{q2, c2, +d2}:
      F32.is_le(d1, d2)

def solid_material(kind: U32, +code: U32) -> PieceArt.Material:
  Bool.pick(PieceArt.Material, U32.is_ge(code, 8),
    PieceArt.Material{2443106, 4877436, 9154232, 529704},
    PieceArt.Material{15453600, 10125663, 16773581, 7689275})

type Channels is Data:
  Channels{colors: Image, mask: Image}

# Quarter-sample compositor: choose a face at each sample before blending.
# Centroid painter order is retained; this is not a geometric depth buffer.
type FourSamples is Data:
  FourSamples{a: Maybe<&2, U32>, b: Maybe<&2, U32>, c: Maybe<&2, U32>, d: Maybe<&2, U32>}

type SampleSum is Data:
  SampleSum{red: U32, green: U32, blue: U32, count: U32}

def selected(covered: Bool, color: U32, prior: Maybe<&2, U32>) -> Maybe<&2, U32>:
  match covered:
    case True{}: Some{color}
    case False{}: prior

def clip_case(excluded: Bool, face: Painted, rest: List<&2, Painted>) -> List<&2, Painted>:
  match excluded:
    case True{}: rest
    case False{}: face <> rest

def clip_face(+face: Painted, +x: F32, +y: F32, +size: F32,
  rest: List<&2, Painted>) -> List<&2, Painted>:
  match face:
    case Painted{+quad, color, depth}:
      match quad:
        case Quad.Shape{ab, bc, cd, da, area}:
          clip_case(Bool.or(F32.is_le(area, 0.1), Quad.outside(quad, x, y, size)), face, rest)

def clipped(faces: List<&2, Painted>, +x: F32, +y: F32, +size: F32) -> List<&2, Painted>:
  match faces:
    case Nil{}: Nil{}
    case face <> rest: clip_face(face, x, y, size, clipped(rest, x, y, size))

def four_face(+quad: Quad.Shape, +color: U32, +x: F32, +y: F32,
  prior: FourSamples) -> FourSamples:
  match prior:
    case FourSamples{a, b, c, d}:
      aa bb cc dd = selected(Bool.not(Quad.outside(quad, F32.add(x, 0.25), F32.add(y, 0.25), 0.0)), color, a)
        selected(Bool.not(Quad.outside(quad, F32.add(x, 0.75), F32.add(y, 0.25), 0.0)), color, b)
        selected(Bool.not(Quad.outside(quad, F32.add(x, 0.25), F32.add(y, 0.75), 0.0)), color, c)
        selected(Bool.not(Quad.outside(quad, F32.add(x, 0.75), F32.add(y, 0.75), 0.0)), color, d)
      FourSamples{aa, bb, cc, dd}

def sampled(faces: List<&2, Painted>, +x: F32, +y: F32,
  prior: FourSamples) -> FourSamples:
  match faces:
    case Nil{}: prior
    case Painted{quad, color, depth} <> rest:
      sampled(rest, x, y, four_face(quad, color, x, y, prior))

def sample_add(sample: Maybe<&2, U32>, total: SampleSum) -> SampleSum:
  match sample total:
    case None{} _: total
    case Some{+color} SampleSum{red, green, blue, count}:
      SampleSum{U32.add(red, Color.red(color)), U32.add(green, Color.green(color)),
        U32.add(blue, Color.blue(color)), U32.add(count, 1)}

def sum_leaf(total: SampleSum) -> Channels:
  match total:
    case SampleSum{red, green, blue, 0}: Channels{Pix{0}, Pix{0}}
    case SampleSum{red, green, blue, +count}:
      +alpha = U32.div(U32.mul(count, 255), 4)
      Channels{Pix{Color.rgb(U32.div(U32.add(red, U32.div(count, 2)), count),
        U32.div(U32.add(green, U32.div(count, 2)), count),
        U32.div(U32.add(blue, U32.div(count, 2)), count))},
        Pix{Color.rgb(alpha, alpha, alpha)}}

def four_leaf(samples: FourSamples) -> Channels:
  match samples:
    case FourSamples{a, b, c, d}:
      sum_leaf(sample_add(d, sample_add(c, sample_add(b,
        sample_add(a, SampleSum{0, 0, 0, 0})))))

def joined(a: Channels, b: Channels, c: Channels, d: Channels) -> Channels:
  match a b c d:
    case Channels{ca, ma} Channels{cb, mb} Channels{cc, mc} Channels{cd, md}:
      Channels{Qua{ca, cb, cc, cd}, Qua{ma, mb, mc, md}}

def sampled_tree(+depth: Nat, +size: U32, +x: F32, +y: F32,
  +faces: List<&2, Painted>) -> Channels:
  match depth faces:
    case _ Nil{}: Channels{Pix{0}, Pix{0}}
    case 0n face <> tail:
      four_leaf(sampled(face <> tail, x, y, FourSamples{None{}, None{}, None{}, None{}}))
    case 1n+rest face <> tail:
      +half = U32.div(size, 2)
      +delta = U32.to_f32(half)
      a b c d = sampled_tree(rest, half, x, y, clipped(faces, x, y, delta))
        sampled_tree(rest, half, F32.add(x, delta), y, clipped(faces, F32.add(x, delta), y, delta))
        sampled_tree(rest, half, x, F32.add(y, delta), clipped(faces, x, F32.add(y, delta), delta))
        sampled_tree(rest, half, F32.add(x, delta), F32.add(y, delta),
          clipped(faces, F32.add(x, delta), F32.add(y, delta), delta))
      joined(a, b, c, d)

def sampled_result(+depth: Nat, +size: U32, channels: Channels) -> Sample.Texture:
  match channels:
    case Channels{colors, mask}: Sample.Texture{depth, size, colors, mask}

# Keep the horse profile readable alongside the upright atlas pieces. This is
# a continuous artwork pose; board placement still uses the actual camera.
# Preparing faces and alpha together keeps visibility, depth and picking aligned.
def presentation_camera(camera: Camera.Basis) -> Camera.Basis:
  match camera:
    case Camera.Basis{cosYaw, sinYaw, sinPitch, cosPitch, scale, cx, cy}:
      +angle = F32.mul(sinYaw, 0.5235987755982988)
      Camera.Basis{F32.cos(angle), F32.sin(angle),
        F32.min(sinPitch, 0.6427876096865394),
        F32.max(cosPitch, 0.766044443118978), scale, cx, cy}

def texture(+depth: Nat, +size: U32, camera: Camera.Basis, code: U32) -> Sample.Texture:
  +faces = prepared(knight_mesh(), presentation_camera(camera), size, solid_material(2, code))
  sampled_result(depth, size,
    sampled_tree(depth, size, 0.0, 0.0,
      clipped(List.sort(~Painted, ~painted_le, faces), 0.0, 0.0, U32.to_f32(size))))
