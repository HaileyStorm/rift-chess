# Sculpted Knight: tapered throat, closed components and shared color/mask coverage.
# Material IDs: 0 body, 1 brass pedestal, 2 gold mane; facial marks stay dark.
import Base
import ../Camera.bend as Camera
import ../../lib/graphics/Quad.bend as Quad
import ../../lib/graphics/v2/Color.bend as Color
import ../../lib/graphics/v2/RgbaSample.bend as Sample
import ../../lib/graphics/v2/Transform2D.bend as Transform
import ./PieceArt.bend as PieceArt

type Vertex is Data:
  Vertex{file: F32, row: F32, height: F32}

type Mark is Data:
  Mark{a: Vertex, b: Vertex, c: Vertex}

type Face is Data:
  Face{a: Vertex, b: Vertex, c: Vertex, d: Vertex,
    normal: Vertex, center: Vertex, band: U32, marks: List<&2, Mark>}

type Colors is Data:
  Colors{ivory: U32, navy: U32}

type Surface is Data:
  Surface{colors: Colors, marks: List<&2, Quad.Shape>}

type Textures is Data:
  Textures{ivory: Sample.Texture, navy: Sample.Texture}

type Painted is Data:
  Painted{quad: Quad.Shape, color: Surface, depth: F32}

# Model bounds normalized by board pitch with a transparent frame margin.
# Rendering and picking call this same frame, preserving the world-scale pivot.
def frame_width() -> F32: 0.68266666666666664
def frame_height() -> F32: 1.5245333333333333
def frame_left() -> F32: 0.34133333333333332
def frame_top() -> F32: 1.16

def frame(+pitch: F32, center: Quad.Point) -> Transform.Matrix:
  match center:
    case Quad.Point{x, y}:
      Transform.Matrix{F32.mul(pitch, frame_width()), 0.0, 0.0,
        F32.mul(pitch, frame_height()),
        F32.sub(x, F32.mul(pitch, frame_left())),
        F32.sub(y, F32.mul(pitch, frame_top()))}

