  Face{Vertex{0.081358313817, F32.neg(0.059733333333), 1.08}, Vertex{0.037096018735, F32.neg(0.029866666667), 0.987142857143}, Vertex{0.06449648712, F32.neg(0.069333333333), 0.987142857143}, Vertex{0.06449648712, F32.neg(0.069333333333), 0.987142857143}, Vertex{F32.neg(0.804204941451), F32.neg(0.558334258623), 0.203757865601}, Vertex{0.061861826698, F32.neg(0.057066666667), 1.010357142857}, 0, Nil{}} <>
  Face{Vertex{0.081358313817, F32.neg(0.059733333333), 1.08}, Vertex{0.06449648712, F32.neg(0.069333333333), 0.987142857143}, Vertex{0.093302107728, F32.neg(0.029866666667), 0.987142857143}, Vertex{0.093302107728, F32.neg(0.029866666667), 0.987142857143}, Vertex{0.804784414407, F32.neg(0.587389725837), F32.neg(0.085412857989)}, Vertex{0.083114754098, F32.neg(0.0472), 1.010357142857}, 0, Nil{}} <>
  Nil{}


def view_dot(vertex: Vertex, camera: Camera.Basis) -> F32:
  match vertex camera:
    case Vertex{+file, +row, +height} Camera.Basis{cosYaw, sinYaw, sinPitch, +cosPitch, scale, cx, cy}:
      F32.add(F32.mul(cosPitch, F32.add(F32.mul(file, sinYaw), F32.mul(row, cosYaw))),
        F32.mul(height, sinPitch))

def project(vertex: Vertex, +size: U32, camera: Camera.Basis) -> Quad.Point:
  match vertex camera:
    case Vertex{+file, +row, height}
        Camera.Basis{+cosYaw, +sinYaw, sinPitch, cosPitch, scale, cx, cy}:
      +span = F32.add(F32.abs(cosYaw), F32.abs(sinYaw))
      +x = F32.div(F32.sub(F32.mul(cosYaw, file), F32.mul(sinYaw, row)), span)
      +y = F32.div(F32.sub(F32.mul(sinPitch,
        F32.add(F32.mul(sinYaw, file), F32.mul(cosYaw, row))),
        F32.mul(cosPitch, height)), span)
      Quad.Point{F32.mul(U32.to_f32(size), F32.div(F32.add(x, frame_left()), frame_width())),
        F32.mul(U32.to_f32(size), F32.div(F32.add(y, frame_top()), frame_height()))}

def projected_marks(marks: List<&2, Mark>, +camera: Camera.Basis, +size: U32) -> List<&2, Quad.Shape>:
  match marks:
    case Nil{}: Nil{}
    case mark <> rest:
      match mark:
        case Mark{a, b, c}:
          +pc = project(c,size,camera)
          Quad.make(project(a,size,camera),project(b,size,camera),
            pc,pc) <> projected_marks(rest,camera,size)

# A fixed frontal key light keeps the broad visible side readable.
# Signed diffuse shades side planes; the polished highlight favors lit bevels.
def light(normal: Vertex) -> F32:
  match normal:
    case Vertex{file, row, height}:
      F32.add(F32.add(F32.mul(file, F32.neg(0.45)),
        F32.mul(row, 0.55)), F32.mul(height, 0.75))

def diffuse(+value: F32) -> U32:
  F32.to_u32(F32.min(255.0, F32.max(0.0,
    F32.add(140.0, F32.mul(116.0, value)))))

def highlight(value: F32) -> U32:
  +v = F32.max(0.0, F32.min(1.0, value))
  +square = F32.mul(v, v)
  F32.to_u32(F32.add(F32.mul(v, 18.0),
    F32.mul(F32.mul(square, square), 180.0)))

def body_ink(+normal: Vertex, body: U32, glint: U32, shadow: U32) -> U32:
  +value = light(normal)
  Color.over(glint, Color.over(body, shadow, diffuse(value)), highlight(value))

def ink(band: U32, +normal: Vertex, style: PieceArt.Material) -> U32:
  match band style:
    case 0 PieceArt.Material{body, shade, glint, shadow}:
      body_ink(normal, body, glint, shadow)
    case 1 PieceArt.Material{body, shade, glint, shadow}:
      body_ink(normal, 11499576, 16244390, 6173718)
    case 2 PieceArt.Material{body, shade, glint, shadow}:
      body_ink(normal, 11499576, 16244390, 6173718)
    case _ _: 463386

# Marks affect the color of the winning quarter; occupancy stays shared.
def marked_at(marks: List<&2, Quad.Shape>, colors: Colors, +x: F32, +y: F32) -> Colors:
  match marks:
    case Nil{}: colors
    case mark <> rest:
      Bool.pick(Colors, Quad.outside(mark,x,y,0.0),
        marked_at(rest,colors,x,y), Colors{463386,463386})

def surface_at(surface: Surface, x: F32, y: F32) -> Colors:
  match surface:
    case Surface{colors,marks}: marked_at(marks,colors,x,y)

def finish_sample(sample: Maybe<&2, Surface>, x: F32, y: F32) -> Maybe<&2, Colors>:
  match sample:
    case None{}: None{}
    case Some{surface}: Some{surface_at(surface,x,y)}

def solid_material(kind: U32, +code: U32) -> PieceArt.Material:
  Bool.pick(PieceArt.Material, U32.is_ge(code, 8),
    PieceArt.Material{2443106, 4877436, 9154232, 529704},
    PieceArt.Material{15453600, 10125663, 16773581, 7689275})

def prepare_case(visible: Bool, face: Face, +camera: Camera.Basis,
  +size: U32) -> Maybe<Painted>:
  match visible face:
    case False{} _: None{}
    case True{} Face{a, b, c, d, +normal, middle, +band, marks}:
      Some{Painted{Quad.make(project(a, size, camera), project(b, size, camera),
        project(c, size, camera), project(d, size, camera)),
        Surface{Colors{ink(band,normal,solid_material(2,2)),
          ink(band,normal,solid_material(2,10))},
          projected_marks(marks, camera, size)}, view_dot(middle, camera)}}

def prepare(+face: Face, +camera: Camera.Basis,
  size: U32) -> Maybe<Painted>:
  match face:
    case Face{a, b, c, d, normal, middle, band, marks}:
      prepare_case(F32.is_gt(view_dot(normal, camera), 0.00001), face,
        camera, size)

def prepared_next(next: Maybe<Painted>, rest: List<&2, Painted>) -> List<&2, Painted>:
  match next:
    case None{}: rest
    case Some{face}: face <> rest

def prepared(mesh: List<&2, Face>, +camera: Camera.Basis,
  +size: U32) -> List<&2, Painted>:
  match mesh:
    case Nil{}: Nil{}
    case face <> rest:
      prepared_next(prepare(face, camera, size), prepared(rest, camera, size))

def painted_le(a: Painted, b: Painted) -> Bool:
  match a b:
    case Painted{q1, c1, +d1} Painted{q2, c2, +d2}:
      F32.is_le(d1, d2)


type Channels is Data:
  Channels{ivory: Image, navy: Image, mask: Image}

# Quarter-sample compositor: choose a face at each sample before blending.
# Centroid painter order is retained; this is not a geometric depth buffer.
type FourSamples is Data:
  FourSamples{a: Maybe<&2, Surface>, b: Maybe<&2, Surface>, c: Maybe<&2, Surface>, d: Maybe<&2, Surface>}

type SampleSum is Data:
  SampleSum{ivory_red: U32, ivory_green: U32, ivory_blue: U32,
    navy_red: U32, navy_green: U32, navy_blue: U32, count: U32}

def selected(covered: Bool, color: Surface, prior: Maybe<&2, Surface>) -> Maybe<&2, Surface>:
  match covered:
    case True{}: Some{color}
    case False{}: prior

def clip_case(excluded: Bool, face: Painted, rest: List<&2, Painted>) -> List<&2, Painted>:
  match excluded:
    case True{}: rest
    case False{}: face <> rest

def clip_face(+face: Painted, +x: F32, +y: F32, +size: F32,
  rest: List<&2, Painted>) -> List<&2, Painted>:
  match face:
    case Painted{+quad, color, depth}:
      match quad:
        case Quad.Shape{ab, bc, cd, da, area}:
          clip_case(Bool.or(F32.is_le(area, 0.1), Quad.outside(quad, x, y, size)), face, rest)

def clipped(faces: List<&2, Painted>, +x: F32, +y: F32, +size: F32) -> List<&2, Painted>:
  match faces:
    case Nil{}: Nil{}
    case face <> rest: clip_face(face, x, y, size, clipped(rest, x, y, size))

# Preserve Quad.outside's exact edge arithmetic and order, but defer each
# remaining pure edge until the preceding edge did not reject the region.
# Passing edges rather than booleans avoids eager evaluation of rejected work.

def outside_after_cd(rejected: Bool, da: Quad.Edge,
  x: F32, y: F32, size: F32) -> Bool:
  match rejected:
    case True{}: True{}
    case False{}: F32.is_lt(Quad.edge.high(da,x,y,size),0.0)

def outside_after_bc(rejected: Bool, cd: Quad.Edge, da: Quad.Edge,
  +x: F32, +y: F32, +size: F32) -> Bool:
  match rejected:
    case True{}: True{}
    case False{}: outside_after_cd(F32.is_lt(Quad.edge.high(cd,x,y,size),0.0),
      da,x,y,size)

def outside_after_ab(rejected: Bool, bc: Quad.Edge, cd: Quad.Edge,
  da: Quad.Edge, +x: F32, +y: F32, +size: F32) -> Bool:
  match rejected:
    case True{}: True{}
    case False{}: outside_after_bc(F32.is_lt(Quad.edge.high(bc,x,y,size),0.0),
      cd,da,x,y,size)

def outside(quad: Quad.Shape, +x: F32, +y: F32, +size: F32) -> Bool:
  match quad:
    case Quad.Shape{ab,bc,cd,da,area}:
      outside_after_ab(F32.is_lt(Quad.edge.high(ab,x,y,size),0.0),
        bc,cd,da,x,y,size)

# Only sampled_tree descendants call this filter. Their immutable areas were
# already admitted by the original root clipped operation; do not check again.
def clip_child(+face: Painted, +x: F32, +y: F32, +size: F32,
  rest: List<&2, Painted>) -> List<&2, Painted>:
  match face:
    case Painted{quad,color,depth}: clip_case(outside(quad,x,y,size),face,rest)

def clipped_children(faces: List<&2, Painted>, +x: F32, +y: F32,
  +size: F32) -> List<&2, Painted>:
  match faces:
    case Nil{}: Nil{}
    case face <> rest: clip_child(face,x,y,size,clipped_children(rest,x,y,size))

def four_face(+quad: Quad.Shape, +color: Surface, +x: F32, +y: F32,
  prior: FourSamples) -> FourSamples:
  match prior:
    case FourSamples{a, b, c, d}:
      aa bb cc dd = selected(Bool.not(outside(quad, F32.add(x, 0.25), F32.add(y, 0.25), 0.0)), color, a)
        selected(Bool.not(outside(quad, F32.add(x, 0.75), F32.add(y, 0.25), 0.0)), color, b)
        selected(Bool.not(outside(quad, F32.add(x, 0.25), F32.add(y, 0.75), 0.0)), color, c)
        selected(Bool.not(outside(quad, F32.add(x, 0.75), F32.add(y, 0.75), 0.0)), color, d)
      FourSamples{aa, bb, cc, dd}

def sampled(faces: List<&2, Painted>, +x: F32, +y: F32,
  prior: FourSamples) -> FourSamples:
  match faces:
    case Nil{}: prior
    case Painted{quad, color, depth} <> rest:
      sampled(rest, x, y, four_face(quad, color, x, y, prior))

def sample_add(sample: Maybe<&2, Colors>, total: SampleSum) -> SampleSum:
  match sample total:
    case None{} _: total
    case Some{Colors{+ivory,+navy}} SampleSum{ir,ig,ib,nr,ng,nb,count}:
      SampleSum{U32.add(ir,Color.red(ivory)),U32.add(ig,Color.green(ivory)),
        U32.add(ib,Color.blue(ivory)),U32.add(nr,Color.red(navy)),
        U32.add(ng,Color.green(navy)),U32.add(nb,Color.blue(navy)),U32.add(count,1)}

def average_color(red: U32, green: U32, blue: U32, +count: U32) -> U32:
  Color.rgb(U32.div(U32.add(red,U32.div(count,2)),count),
    U32.div(U32.add(green,U32.div(count,2)),count),
    U32.div(U32.add(blue,U32.div(count,2)),count))

def sum_leaf(total: SampleSum) -> Channels:
  match total:
    case SampleSum{ir,ig,ib,nr,ng,nb,0}: Channels{Pix{0},Pix{0},Pix{0}}
    case SampleSum{ir,ig,ib,nr,ng,nb,+count}:
      +alpha = U32.div(U32.mul(count, 255), 4)
      Channels{Pix{average_color(ir,ig,ib,count)},Pix{average_color(nr,ng,nb,count)},
        Pix{Color.rgb(alpha, alpha, alpha)}}

def four_leaf(samples: FourSamples, +x: F32, +y: F32) -> Channels:
  match samples:
    case FourSamples{a, b, c, d}:
      sum_leaf(sample_add(finish_sample(d,F32.add(x,0.75),F32.add(y,0.75)),
        sample_add(finish_sample(c,F32.add(x,0.25),F32.add(y,0.75)),
        sample_add(finish_sample(b,F32.add(x,0.75),F32.add(y,0.25)),
        sample_add(finish_sample(a,F32.add(x,0.25),F32.add(y,0.25)),SampleSum{0,0,0,0,0,0,0})))))

# Uniform channel regions retain one Pix instead of four identical leaves.
# Color, quarter-sample coverage, geometry and channel extent are unchanged.
def compact_case(same: Bool, color: U32,
  a: Image, b: Image, c: Image, d: Image) -> Image:
  match same:
    case True{}: Pix{color}
    case False{}: Qua{a,b,c,d}

def compact(+a: Image, +b: Image, +c: Image, +d: Image) -> Image:
  match a b c d:
    case Pix{+ca} Pix{cb} Pix{cc} Pix{cd}:
      compact_case(Bool.and(Bool.and(U32.is_eq(ca,cb),U32.is_eq(ca,cc)),
        U32.is_eq(ca,cd)),ca,a,b,c,d)
    case _ _ _ _: Qua{a,b,c,d}

def joined(a: Channels, b: Channels, c: Channels, d: Channels) -> Channels:
  match a b c d:
    case Channels{ia,na,ma} Channels{ib,nb,mb} Channels{ic,nc,mc} Channels{id,nd,md}:
      Channels{compact(ia,ib,ic,id),compact(na,nb,nc,nd),compact(ma,mb,mc,md)}

def sampled_tree(+depth: Nat, +size: U32, +x: F32, +y: F32,
  +faces: List<&2, Painted>) -> Channels:
  match depth faces:
    case _ Nil{}: Channels{Pix{0},Pix{0},Pix{0}}
    case 0n face <> tail:
      four_leaf(sampled(face <> tail, x, y, FourSamples{None{}, None{}, None{}, None{}}),x,y)
    case 1n+rest face <> tail:
      +half = U32.div(size, 2)
      +delta = U32.to_f32(half)
      a b c d = sampled_tree(rest, half, x, y, clipped_children(faces, x, y, delta))
        sampled_tree(rest, half, F32.add(x, delta), y, clipped_children(faces, F32.add(x, delta), y, delta))
        sampled_tree(rest, half, x, F32.add(y, delta), clipped_children(faces, x, F32.add(y, delta), delta))
        sampled_tree(rest, half, F32.add(x, delta), F32.add(y, delta),
          clipped_children(faces, F32.add(x, delta), F32.add(y, delta), delta))
      joined(a, b, c, d)

def sampled_result(+depth: Nat, +size: U32, channels: Channels) -> Textures:
  match channels:
    case Channels{ivory,navy,+mask}:
      Textures{Sample.Texture{depth,size,ivory,mask},Sample.Texture{depth,size,navy,mask}}

# Keep the horse profile readable alongside the upright atlas pieces. This is
# a continuous artwork pose; board placement still uses the actual camera.
# Preparing faces and alpha together keeps visibility, depth and picking aligned.
def presentation_camera(camera: Camera.Basis) -> Camera.Basis:
  match camera:
    case Camera.Basis{cosYaw, sinYaw, sinPitch, cosPitch, scale, cx, cy}:
      +angle = F32.mul(sinYaw, 0.5235987755982988)
      Camera.Basis{F32.cos(angle), F32.sin(angle),
        F32.min(sinPitch, 0.6427876096865394),
        F32.max(cosPitch, 0.766044443118978), scale, cx, cy}

# Both materials share projection, painter order, quarter-sample coverage and
# alpha. Only their original colors are accumulated separately.
def textures(+depth: Nat, +size: U32, camera: Camera.Basis) -> Textures:
  +faces = prepared(knight_mesh(), presentation_camera(camera), size)
  sampled_result(depth, size,
    sampled_tree(depth, size, 0.0, 0.0,
      clipped(List.sort(~Painted, ~painted_le, faces), 0.0, 0.0, U32.to_f32(size))))
