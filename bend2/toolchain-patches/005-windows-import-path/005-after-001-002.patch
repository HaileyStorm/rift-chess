+function path_posix(file: string): string {
+  return file.replaceAll(path.sep, "/");
+}
+
+export function relative_module_path(dir: string, file: string): string {
+  if (process.platform === "win32" &&
+      path.parse(path.resolve(dir)).root.toLowerCase() !==
+      path.parse(path.resolve(file)).root.toLowerCase()) {
+    throw new Error("cross-volume local imports are not supported");
+  }
+  const rel = path.relative(dir, file);
+  if (path.isAbsolute(rel)) {
+    throw new Error("cross-volume local imports are not supported");
+  }
+  return path_posix(rel);
