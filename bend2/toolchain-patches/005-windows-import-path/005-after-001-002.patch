+function file_id_map(seen: Map<string, string | null>): Map<string, string | null> {
+  let ids = seen_file_ids.get(seen);
+  if (ids === undefined) {
+    ids = new Map();
+    seen_file_ids.set(seen, ids);
+  }
+  return ids;
+}
+
+export function book_seen(seen: Map<string, string | null>, file: string): boolean {
+  if (seen.has(file)) {
+    return true;
+  }
+  const identity = file_identity_key(file);
+  return identity !== null && file_id_map(seen).has(identity);
+}
