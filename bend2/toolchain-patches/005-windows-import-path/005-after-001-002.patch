+function file_identity_key(file: string): string | null {
+  if (process.platform !== "win32") {
+    return null;
+  }
+  const stat = fs.statSync(file, { bigint: true });
+  if (stat.dev === 0n || stat.ino === 0n) {
+    throw new Error("this Windows filesystem does not expose a stable file identity");
+  }
+  return "\0bend-file:" + stat.dev.toString() + ":" + stat.ino.toString();
