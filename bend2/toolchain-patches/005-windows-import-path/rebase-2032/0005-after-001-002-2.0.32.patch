+function path_with_missing_tail(file: string): string | null {
+  let at = path.resolve(file);
+  const tail: string[] = [];
+  while (!fs.existsSync(at)) {
+    const parent = path.dirname(at);
+    if (parent === at) {
+      return null;
+    }
+    tail.unshift(path.basename(at));
+    at = parent;
+  }
+  try {
+    return path.resolve(fs.realpathSync(at), ...tail);
+  } catch {
+    return null;
+  }
