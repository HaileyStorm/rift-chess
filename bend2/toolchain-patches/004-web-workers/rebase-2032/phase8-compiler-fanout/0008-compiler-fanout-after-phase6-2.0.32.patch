+  let sourceRequires = 0;
+  const visit = (term: HTerm, depth = 0): void => {
+    if (depth > 4096) throw new Error("required fan-out caller term exceeds the bounded source walk");
+    const node = term_force(term);
+    if (node.$ === "Let") {
+      const siblingCalls = node.v.map((value) => term_spine(callerFile, value));
+      const required = siblingCalls.filter((call) => call.web === "require");
+      if (required.length > 0) {
