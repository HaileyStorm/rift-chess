+/** Lower one checked parallel-let fan-out into the versioned bounded pool runtime. */
+export function js_required_fanout_lib(book: Bend.Book, caller: Name): WebRequiredFanoutBuild {
+  if (!book.order.includes(caller)) {
+    throw new Error("required fan-out caller must be a filled pure first-order U32 -> U32 definition: " + caller);
+  }
+  if ((`bend:${caller}:parallel-let`).length > 128) {
+    throw new Error("generated fan-out regionId exceeds the phase-seven runtime limit of 128 characters");
+  }
+  const plan = plan_web_workers(book, [caller]);
+  const callTargets = new Map<Name, Name[]>();
+  for (const call of plan.calls) {
+    const targets = callTargets.get(call.from) ?? [];
+    targets.push(call.to);
+    callTargets.set(call.from, targets);
+  }
+  const pending = [...callTargets.get(caller) ?? []];
+  const visited = new Set<Name>();
+  let recursive = false;
+  while (pending.length > 0) {
+    const target = pending.pop() as Name;
+    if (target === caller) { recursive = true; break; }
+    if (visited.has(target)) continue;
+    visited.add(target);
+    pending.push(...callTargets.get(target) ?? []);
+  }
+  if (recursive) {
+    throw new Error("required fan-out caller cannot be self- or mutually-recursive because its lowered calls are async");
+  }
+  const callerFile = file_book(book, [caller], true);
+  if (plan.conflicts.length > 0) {
+    throw new Error("strict required fan-out policy conflict: " + plan.conflicts[0].kind);
+  }
+  const callerStatus = plan.functions.find((fn) => fn.name === caller);
+  const unsupportedCaller = callerStatus?.reasons.filter((reason) =>
+    /^(unsafe_reachable|foreign_reachable|unfilled_reachable|template_reachable|f32_reachable|higher_order)/
+      .test(reason)) ?? [];
