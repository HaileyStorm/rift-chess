+/** Emit one strict per-call worker for one direct, closed U32 -> U32 requirement. */
+export function js_percall_lib(book: Bend.Book, caller: Name): WebPerCallBuild {
+  if (!book.order.includes(caller)) {
+    throw new Error("per-call worker caller must be a filled pure first-order U32 -> U32 definition: " + caller);
+  }
+  const rejectCallerTailLoop = (): void => {
+    const callerFile = file_book(book, [caller], true);
+    const callerLoop = loop_of(callerFile, caller);
+    if (callerLoop.length > 0) {
+      throw new Error("per-call worker caller cannot participate in a tail-call loop: "
+        + callerLoop.join(" -> "));
+    }
+  };
+  if (!web_per_call_u32_unary(book, caller)) {
+    throw new Error("per-call worker caller must be a filled pure first-order U32 -> U32 definition: " + caller);
+  }
+  rejectCallerTailLoop();
+  const plan = plan_web_workers(book, [caller]);
+  if (plan.conflicts.length > 0) {
+    throw new Error("strict per-call worker policy conflict: " + plan.conflicts[0].kind);
+  }
+  const callerStatus = plan.functions.find((fn) => fn.name === caller);
+  const unsupportedCaller = callerStatus?.reasons.filter((reason) =>
+    /^(unsafe_reachable|foreign_reachable|unfilled_reachable|template_reachable|f32_reachable|higher_order)/
+      .test(reason)) ?? [];
+  if (unsupportedCaller.length > 0) {
+    throw new Error("per-call worker caller has an unsupported dependency: " + unsupportedCaller[0]);
+  }
+  if (plan.requirements.length !== 1 || plan.requirements[0].from !== caller) {
+    throw new Error("strict per-call worker requires exactly one direct required call in the exported caller");
+  }
+  const requirement = plan.requirements[0];
+  if (requirement.max !== undefined) {
+    throw new Error("strict per-call worker does not implement a concurrent @N cap");
+  }
+  const callee = requirement.to;
+  const requireCalls = plan.calls.filter((call) => call.policy === "require");
+  if (requireCalls.length !== 1 || requireCalls[0].from !== caller
+    || requireCalls[0].to !== callee || requireCalls[0].native) {
+    throw new Error("strict per-call worker supports one direct web-only require call");
+  }
+  if (!web_per_call_u32_unary(book, callee)) {
+    throw new Error("required worker callee must be a pure first-order U32 -> U32 definition: " + callee);
+  }
+  const calleePlan = plan_web_workers(book, [callee]);
+  if (!calleePlan.sourceEligible || calleePlan.calls.length !== 0) {
+    throw new Error("required worker callee is outside the closed call-free U32 subset: " + callee);
+  }
+  const callerBook = { ...book, order: [caller] };
+  const calleeBook = { ...book, order: [callee] };
+  return { schema: "bend-percall-build/2032-1", caller, callee,
+    entry: "program.mjs", requirements: plan.requirements,
+    files: {
+      "program.mjs": js_lib_inner(callerBook, true, { caller, callee }),
+      "callee.mjs": js_lib_inner(calleeBook, true),
+      "worker.mjs": web_per_call_worker(callee),
+    } };
+}
