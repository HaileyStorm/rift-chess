+function web_per_call_u32_unary(book: Bend.Book, name: Name): boolean {
+  const def = book.tlds[name];
+  if (def?.$ !== "Def" || def.v === null || def.u === true || def.i !== undefined
+    || def.x !== 0 || def.b === true) return false;
+  const signature = Bend.tele_unbind(book, def.T);
