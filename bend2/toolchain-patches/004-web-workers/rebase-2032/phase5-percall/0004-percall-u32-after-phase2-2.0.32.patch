+function web_per_call_runtime(): string {
+  return `
+export const __bendPerCallTaskWitnesses = [];
+let __bendPerCallNextTask = 0;
+function __bendPerCallExactKeys(value, names) {
+  return value !== null && typeof value === "object" && !Array.isArray(value)
+    && Object.keys(value).length === names.length
+    && names.every((name) => Object.prototype.hasOwnProperty.call(value, name));
+}
+function __bendPerCallDispatch(callee, args) {
+  if (!Array.isArray(args) || args.length !== 1 || !Number.isInteger(args[0])
+    || args[0] < 0 || args[0] > 4294967295) {
+    throw new TypeError("required worker accepts one U32 argument");
+  }
+  const requestId = ++__bendPerCallNextTask;
+  return new Promise((resolve, reject) => {
+    const worker = new Worker(new URL("./worker.mjs", import.meta.url), { type: "module" });
+    let settled = false;
+    const timer = setTimeout(() => finish(new Error("required worker timed out")), 5000);
+    const finish = (error, value) => {
+      if (settled) return;
+      settled = true;
+      clearTimeout(timer);
+      let resultError = error;
+      try {
+        worker.terminate();
+      } catch (cleanupError) {
+        if (resultError === null || resultError === undefined) {
+          resultError = cleanupError;
+        } else if (typeof resultError === "object") {
+          try { resultError.cleanupError = cleanupError; } catch {}
+        }
+      }
+      if (resultError) reject(resultError);
+      else resolve(value);
+    };
+    worker.onmessage = ({ data }) => {
+      if (!__bendPerCallExactKeys(data,
+        ["callee", "ok", "protocol", "requestId", "value", "witness"])
+        || !__bendPerCallExactKeys(data.witness,
+          ["callee", "fetchCalls", "kind", "value", "workerScope"])
+        || data.witness.kind !== "bend-percall-task/2032-1"
+        || data.protocol !== "bend-percall-worker/2032-1" || data.requestId !== requestId
+        || data.callee !== callee || data.ok !== true || !Number.isInteger(data.value)
+        || data.value < 0 || data.value > 4294967295
+        || data.witness?.workerScope !== true || data.witness?.callee !== callee
+        || data.witness?.value !== data.value || data.witness?.fetchCalls !== 0) {
+        finish(new Error("required worker task witness or reply mismatch"));
+        return;
+      }
+      __bendPerCallTaskWitnesses.push(Object.freeze({ ...data.witness, requestId }));
+      finish(null, data.value);
+    };
+    worker.onerror = (event) => finish(new Error(event.message || "required worker failed"));
+    worker.onmessageerror = () => finish(new Error("required worker reply could not be cloned"));
+    try {
+      worker.postMessage({ protocol: "bend-percall-worker/2032-1", requestId, callee, args });
+    } catch (error) {
+      finish(error);
+    }
+  });
+}
+`;
+}
+
+function web_per_call_worker(callee: Name): string {
+  return `
+const protocol = "bend-percall-worker/2032-1";
+const expectedCallee = ${JSON.stringify(callee)};
+let fetchCalls = 0;
+globalThis.fetch = async () => {
+  fetchCalls++;
+  throw new Error("network disabled in required worker");
+};
+self.onmessage = async ({ data }) => {
+  const { protocol: requestProtocol, requestId, callee, args } = data ?? {};
+  try {
+    if (requestProtocol !== protocol || !Number.isSafeInteger(requestId)
+      || callee !== expectedCallee || !Array.isArray(args) || args.length !== 1
+      || !Number.isInteger(args[0]) || args[0] < 0 || args[0] > 4294967295) {
+      throw new Error("invalid required worker request");
+    }
+    const module = await import("./callee.mjs");
+    const library = module?.default;
+    if (!library || Object.keys(library).length !== 1
+      || Object.keys(library)[0] !== expectedCallee || typeof library[expectedCallee] !== "function") {
+      throw new Error("required worker callee module mismatch");
+    }
+    const value = library[expectedCallee](args[0]);
+    if (value !== null && (typeof value === "object" || typeof value === "function")
+      && typeof value.then === "function") throw new Error("required callee returned a promise");
+    if (!Number.isInteger(value) || value < 0 || value > 4294967295) {
+      throw new Error("required callee returned a non-U32 value");
+    }
+    const witness = { kind: "bend-percall-task/2032-1", callee: expectedCallee,
+      workerScope: typeof WorkerGlobalScope !== "undefined" && self instanceof WorkerGlobalScope,
+      value, fetchCalls };
+    self.postMessage({ protocol, requestId, callee, ok: true, value, witness });
+  } catch (error) {
+    self.postMessage({ protocol, requestId, callee: expectedCallee, ok: false,
+      error: String(error?.message ?? error).slice(0, 512), fetchCalls });
+  }
+};
+`;
+}
