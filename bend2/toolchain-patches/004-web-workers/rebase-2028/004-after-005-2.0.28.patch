+        const on = let_live(cb, s), vs = s.v.filter((_, j) => on[j]);
+        if (vs.length >= 2) {
+          const calls = vs.map((v) => call_kind(cb, v));
+          if (calls.every((c) => c !== null && ids.has(c.k))) {
+            maySuspend.add(k);
+            if (calls.some((c) => c!.web !== "never" && functions[ids.get(c!.k)!].eligible)) forks.add(k);
+          }
+          else for (const c of calls) {
+            const target = c === null ? undefined : functions[ids.get(c.k) ?? -1];
+            if (target?.eligible) continue;
+            for (const reason of target?.reasons ?? ["not_saturated_or_named"]) diagnostics.push({
+              function: k, line: s.s ? s.s.src.slice(0, s.s.beg).split("\n").length : null,
+              ...(c ? { callee: c.k } : {}), reason, severity: "info",
+            });
+          }
+        }
+      }
+      return false;
+    });
+  }
+  changed = true;
+  while (changed) {
+    changed = false;
+    for (const [k, deps] of refs) {
+      if (!maySuspend.has(k) && [...deps].some((d) => maySuspend.has(d))) {
+        maySuspend.add(k); changed = true;
+      }
+      if (!forks.has(k) && [...forkRefs.get(k)!].some((d) => forks.has(d))) { forks.add(k); changed = true; }
+    }
+  }
+  for (const f of functions) { f.maySuspend = maySuspend.has(f.name); f.hasFork = forks.has(f.name); }
+  const sites: WebSite[] = [];
+  const fl = file_new(cb, true);
+  fl.tab = 0;
+  fl.web = { ids, functions, sites, maySuspend, policy, diagnostics };
+  for (const [k, d] of defs) {
+    if (!maySuspend.has(k) || intr_of(cb, k, true)) continue;
+    memo_gc();
+    fl.fresh = new Map();
+    fl.def = k;
+    fl.fuel = FOLD_FUEL;
+    const params = sig_def(cb, k).live.map(([, n]) => name_local(fl, n));
+    block(fl, `function* $web${ids.get(k)}(${params.join(", ")}) {`, () => js_func(fl, d.h!, d.T, params));
+    file_push(fl, "");
+  }
+  // Coordinator table optimizations get their own namespace, never colliding
+  // with tables already emitted by the serial oracle.
+  const emitted = fl.seg.lines.join("\n").replace(/\bTAB_(\d+)\b/g, "WEB_TAB_$1")
+    + "\n" + [...fl.tabs].map(([r, i]) => `const WEB_TAB_${i} = [${r}];`).join("\n");
+  const runtime = fs.readFileSync(path.join(Bend.BEND_DIR, "web_runtime.js"), "utf8").replace(/\r\n/g, "\n");
+  const exports = Object.fromEntries(roots.map((k) => [k, ids.get(k)!]));
+  const program = crypto.createHash("sha256").update(JSON.stringify({
+    backend: "bend-web-workers-2", serial, emitted, runtime, schemas, functions, sites, exports, mode, policy,
+  })).digest("hex");
+  const prefix = "bend-" + program.slice(0, 16);
+  const artifacts = { entry: "index.mjs", program: prefix + ".program.mjs",
+    worker: prefix + ".worker.mjs", runtime: prefix + ".runtime.mjs", manifest: "manifest.json" };
+  const manifest = { protocol: 1, program, backend: "bend-web-workers-2", mode, policy,
+    schemas, functions, sites, exports, artifacts };
+  const data = JSON.stringify(manifest);
+  const programSource = `import {web_call, web_tail, web_fork, freezeProgramData} from "./${artifacts.runtime}";\n`
+    + serial + "\n" + emitted + "\nexport const manifest = freezeProgramData(" + data + ");\n"
+    + "export const serial = Object.freeze([\n" + defs.map(([k]) => {
+      const intr = intr_of(cb, k, true);
+      const call = intr ? tpl(intr.JS, sig_def(cb, k).live.map((_, i) => `args[${i}]`)) : `run_loop(${js_sat(k)}(...args))`;
+      return `  (...args) => ${call},`;
+    }).join("\n") + "\n]);\n"
+    + "export const coordinators = Object.freeze([" + defs.map(([k]) => maySuspend.has(k) ? "$web" + ids.get(k) : "null").join(", ") + "]);\n";
+  const files: Record<string, string> = {
+    [artifacts.entry]: `import * as program from "./${artifacts.program}";\nimport {createWorkerSession} from "./${artifacts.runtime}";\n`
+      + `export const manifest = program.manifest;\nexport function createSession(options = {}) {\n`
+      + `  return createWorkerSession(program, new URL("./${artifacts.worker}", import.meta.url), options);\n}\n`,
+    [artifacts.program]: programSource,
+    [artifacts.worker]: `import * as program from "./${artifacts.program}";\nimport {serveWorker} from "./${artifacts.runtime}";\nserveWorker(program);\n`,
+    [artifacts.runtime]: runtime,
+    [artifacts.manifest]: JSON.stringify(manifest, null, 2) + "\n",
+  };
+  return { files, entry: artifacts.entry, manifest, diagnostics };
+}
