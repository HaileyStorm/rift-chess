+    const output = web_schema(cb, T, schemas, keys);
+    return { inputs, output, reasons: [] };
+  } catch (e) {
+    schemas.splice(begin);
+    keys.clear();
+    for (const [k, v] of oldKeys) keys.set(k, v);
+    return { inputs: null, output: null, reasons: [String((e as Error).message)] };
+  }
