+// Compile all artifacts in one serialized operation. Does not mutate the
+// source book, create pools at import, or change js_lib's synchronous API.
+export function js_worker_lib(book: Bend.Book, roots: Name[],
+  options: WebWorkerOptions = {}): WebWorkerBuild {
+  const mode = options.mode ?? "auto";
+  const policy = options.policy ?? (mode === "required-only" ? "strict" : "permissive");
+  if (!["marked", "auto", "required-only", "off"].includes(mode)) throw new Error("unknown worker mode");
+  if (!["strict", "permissive"].includes(policy)) throw new Error("unknown worker policy");
+  if (roots.length === 0 || new Set(roots).size !== roots.length) throw new Error("select distinct worker exports");
+  for (const k of roots) {
+    const d = book.tlds[k];
+    if (!done_live(d) || def_foreign(d) || d.x !== 0 || d.b) throw new Error("worker export must be a filled, non-base, non-template, non-foreign definition: " + k);
+  }
+  // This remains the existing serial implementation, byte for byte.
+  const serial = js_lib(book, roots, null, { internal: true });
+  const cb = carb_book(book, roots);
+  const explicitIntrinsics = new Set<Name>();
+  for (const [, d] of done_defs(cb)) term_any(cb, d.h!, (t) => {
+    if (t.$ === "Ref" && t.web && intr_of(cb, t.k, true)) explicitIntrinsics.add(t.k);
+    return false;
+  });
+  const defs = done_defs(cb).filter(([k]) => intr_of(cb, k, true) === undefined);
+  for (const k of explicitIntrinsics) {
+    const d = def_body(cb, k);
+    if (d?.$ === "Def") defs.push([k, d]);
+  }
+  const ids = new Map(defs.map(([k], i) => [k, i]));
+  const schemas: WebSchema[] = [];
+  const keys = new Map<string, number>();
+  const diagnostics: WebDiagnostic[] = [];
+  const functions: WebFunction[] = defs.map(([k, d], id) => ({
+    id, name: k, arity: sig_def(cb, k).live.length,
+    ...web_signature(cb, d, schemas, keys), eligible: false, reachesMark: false, reachesPolicy: false, reachesRequire: false, maySuspend: false, hasFork: false,
+  }));
+  const refs = new Map<Name, Set<Name>>();
+  const forkRefs = new Map<Name, Set<Name>>();
+  const reasons = new Map<Name, Set<string>>();
+  const marks = new Set<Name>();
+  const policies = new Set<Name>();
+  const requiredDefs = new Set<Name>();
+  const requirements: { owner: Name; target: Name; span?: Bend.Span }[] = [];
+  for (const [k, d] of defs) {
+    memo_gc();
+    const deps = new Set<Name>(), bad = new Set<string>();
+    if (d.u) bad.add("unsafe_reachable");
+    // Representation-sensitive float code is excluded even with integer-only
+    // public types. Finite literal constructors do not inspect representation.
+    const intrinsic = intr_of(cb, k, true);
+    if (intrinsic && !WEB_INTRINSICS.has(op_name(k))) bad.add(op_name(k).includes("f32") ? "f32_internal" : "intrinsic_not_allowed");
+    refs.set(k, deps);
+    forkRefs.set(k, new Set());
+    reasons.set(k, bad);
+    if (intrinsic) continue;
+    term_any(cb, d.h!, (s) => {
+      if (s.$ === "Ctr" && s.k === "F32") {
+        const bits = Bend.u32_from_term(s, "F32");
+        if (bits === null || !Number.isFinite(Bend.f32_from_bits(bits))) bad.add("f32_internal");
+      }
+      if (s.$ === "Mat" && s.k === "F32") bad.add("f32_internal");
+      if (s.$ === "Ref") {
+        if (s.web) policies.add(k);
+        if (s.web === "require") { requiredDefs.add(k); requirements.push({ owner: k, target: s.k, span: s.s }); }
+        const ref = def_body(cb, s.k);
+        if (def_foreign(ref)) bad.add("foreign_reachable");
+        else if (intr_of(cb, s.k, true)) {
+          if (!WEB_INTRINSICS.has(op_name(s.k))) bad.add(op_name(s.k).includes("f32") ? "f32_internal" : "intrinsic_not_allowed");
+        } else if (ids.has(s.k)) deps.add(s.k);
+        else if (ref?.$ === "Def") bad.add("unfilled_reachable");
+      }
+      const call = call_kind(cb, s);
+      if (call?.k === CLO_APPLY) bad.add("higher_order_call");
+      if (call?.bang && call.k !== CLO_APPLY) marks.add(k);
+      if (call && ids.has(call.k) && call.web !== "never") forkRefs.get(k)!.add(call.k);
+      return false;
+    });
+  }
+  // Closed-call-graph fixpoint handles self-recursion without treating a
+  // visiting node as a successful proof. Effect and transport facts differ.
+  let changed = true;
+  while (changed) {
+    changed = false;
+    for (const [k, deps] of refs) for (const dep of deps) {
+      for (const r of reasons.get(dep)!) if (!reasons.get(k)!.has(r)) {
+        reasons.get(k)!.add(r); changed = true;
+      }
+      if (marks.has(dep) && !marks.has(k)) { marks.add(k); changed = true; }
+      if (policies.has(dep) && !policies.has(k)) { policies.add(k); changed = true; }
+      if (requiredDefs.has(dep) && !requiredDefs.has(k)) { requiredDefs.add(k); changed = true; }
+    }
+  }
+  for (const f of functions) {
+    f.reasons = [...new Set([...f.reasons, ...reasons.get(f.name)!])].sort();
+    f.eligible = f.reasons.length === 0;
+    f.reachesMark = marks.has(f.name);
+    f.reachesPolicy = policies.has(f.name);
+    f.reachesRequire = requiredDefs.has(f.name);
+    const def = def_body(cb, f.name);
+    const span = def?.$ === "Def" ? def.h?.s : undefined;
+    for (const reason of f.reasons) diagnostics.push({ function: f.name,
+      line: span ? span.src.slice(0, span.beg).split("\n").length : null,
+      reason, severity: "info" });
+  }
+  for (const k of roots) {
+    const bad = reasons.get(k)!;
+    if (bad.has("foreign_reachable") || bad.has("unsafe_reachable") || bad.has("unfilled_reachable"))
+      throw new Error("worker export is not in the closed safe pure subset: " + k + " (" + [...bad].join(", ") + ")");
+  }
+  for (const r of requirements) {
+    const target = functions[ids.get(r.target) ?? -1];
