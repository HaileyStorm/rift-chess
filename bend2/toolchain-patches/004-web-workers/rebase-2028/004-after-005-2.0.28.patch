+      if (policy === "strict") throw new Error(`required worker ${reason} at ${r.owner}:${line ?? "?"} -> ${r.target}`);
+      diagnostics.push({ function: r.owner, callee: r.target, line, reason, severity: "warning" });
+    }
+  }
+  const maySuspend = new Set<Name>(policies);
+  const forks = new Set<Name>();
+  for (const [k, d] of defs) {
+    memo_gc();
