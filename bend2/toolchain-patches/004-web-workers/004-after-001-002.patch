+import Base
+
+def mix(n: Nat, +seed: U32) -> U32:
+  match n:
+    case 0n: seed
+    case 1n+rest:
+      mix(rest, U32.add(U32.mul(seed, 1664525), 1013904223))
+
+def tree(depth: Nat, +work: Nat, +seed: U32) -> U32:
+  match depth:
+    case 0n: mix(work, seed)
+    case 1n++rest:
+      left right = tree(rest, work, seed) tree(rest, work, U32.add(seed, 1))
+      U32.add(U32.mul(left, 31), right)
+
+def marked(depth: Nat, work: Nat, seed: U32) -> U32:
+  tree!(depth, work, seed)
+
+def unmarked(depth: Nat, work: Nat, seed: U32) -> U32:
+  tree(depth, work, seed)
+
+def main() -> U32:
+  marked(2n, 5n, 7)
+
+#|769675072
