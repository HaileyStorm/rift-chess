index 0000000..d0ad85f
--- /dev/null
+++ b/bench/workers/measure.mjs
@@ -0,0 +1,91 @@
+// Local Node-only paired benchmark. Its transport is real worker_threads via a
+// test adapter, not browser module Workers. No native pins are read or changed.
+import fs from 'node:fs';
+import os from 'node:os';
+import path from 'node:path';
+import {pathToFileURL,fileURLToPath} from 'node:url';
+import assert from 'node:assert/strict';
+import {compile} from '../../gates/workers.mjs';
+import {nodeWorkerFactory} from '../../tests/workers/node_adapter.mjs';
+const ROOT=fileURLToPath(new URL('../../',import.meta.url));
+const output=path.resolve(process.argv[2]??'worker-benchmark.json');
+const repeats=Number(process.argv[3]??15);
+if(!Number.isInteger(repeats)||repeats<8||repeats>200)throw new Error('repeats must be 8..200');
+const temp=fs.mkdtempSync(path.join(os.tmpdir(),'bend-web-bench-'));
+const hashValue=x=>JSON.stringify(x,(_,v)=>typeof v==='bigint'?v+'n':v);
+const percentile=(values,p)=>{const xs=[...values].sort((a,b)=>a-b);return xs[Math.min(xs.length-1,Math.floor(p*xs.length))]};
+// Predeclared engineering criteria. Only a browser/static-artifact run could
+// satisfy the guide's browser acceptance; these are informative Node results.
+const criteria={coarseLatencyRatioUpper95:0.8,coarseFixturesRequired:2,
+  tinyAddedP95Ms:0.5,bootstrapResamples:4000,pairedOrder:'rotating interleaved',warmups:4};
+let randomSeed=0x12345678;
+const rand=()=>((randomSeed=(Math.imul(randomSeed,1664525)+1013904223)>>>0)/2**32);
+function pairedCI(rows,name){
+  const samples=[];
+  for(let k=0;k<criteria.bootstrapResamples;k++){
+    let a=0,b=0;for(let i=0;i<rows.length;i++){const row=rows[Math.floor(rand()*rows.length)];a+=row[name];b+=row.legacy}
+    samples.push(a/b);
+  }
+  return [percentile(samples,.025),percentile(samples,.975)];
+}
+const report={status:'informative; not browser acceptance',created:new Date().toISOString(),criteria,
+  environment:{node:process.version,v8:process.versions.v8,platform:process.platform,arch:process.arch,
+    availableParallelism:os.availableParallelism(),logicalCPUs:os.cpus().length,cpu:os.cpus()[0]?.model},
+  memoryMethod:'process.memoryUsage().rss is total process RSS with the harness and co-resident idle pools; heapUsed is coordinator heap only. Not browser memory or per-helper attribution.',fixtures:[]};
+try{
+  const modules={};
+  for(const [name,file,roots] of [['integer','integer_tree',['marked','unmarked']],['image','image_tree',['exported','read_image']]]){
+    const directory=path.join(temp,name),start=performance.now();
+    const b=await compile(path.join(ROOT,'tests/workers/'+file+'.bend'),directory,roots,'marked');
+    const compileMs=performance.now()-start,before=performance.now();
+    modules[name]={...await import(pathToFileURL(path.join(directory,b.entry))),
+      serial:(await import(pathToFileURL(path.join(directory,'serial.mjs')))).default,
+      compileMs,importMs:performance.now()-before,program:b.manifest.program};
+  }
+  const cases=[
+    {name:'integer_coarse',module:'integer',root:'marked',args:[3n,200000n,42],coarse:true},
+    {name:'image_coarse',module:'image',root:'exported',args:[4n,5000n,7],coarse:true},
+    {name:'tiny_fork',module:'integer',root:'marked',args:[3n,0n,42],coarse:false},
+    {name:'large_input_cheap',module:'image',root:'read_image',args:[modules.image.serial.exported(5n,0n,7)],coarse:false},
+  ];
+  for(const fixture of cases){
+    const b=modules[fixture.module],expected=hashValue(b.serial[fixture.root](...fixture.args));
+    const configs=[{name:'legacy'},{name:'zero',workers:0,mode:'off'},
+      {name:'force1',workers:1,diagnosticForce:true},{name:'force2',workers:2,diagnosticForce:true},
+      {name:'force4',workers:4,diagnosticForce:true},{name:'automatic2',workers:2}];
+    const sessions=[];
+    const row={name:fixture.name,coarse:fixture.coarse,program:b.program,compileMs:b.compileMs,importMs:b.importMs,
+      cold:{},raw:[],summary:{},endStats:{},memoryStart:process.memoryUsage(),outputTextBytes:Buffer.byteLength(expected)};
+    try{
+      for(const c of configs){
+        if(c.name!=='legacy'){c.session=b.createSession({workerFactory:nodeWorkerFactory,...c});sessions.push(c.session)}
+        c.run=()=>c.session?c.session.call(fixture.root,fixture.args):b.serial[fixture.root](...fixture.args);
+        const start=performance.now(),value=await c.run();row.cold[c.name]=performance.now()-start;
+        assert.equal(hashValue(value),expected);
+      }
+      for(let i=0;i<criteria.warmups;i++)for(const c of configs)assert.equal(hashValue(await c.run()),expected);
+      for(let i=0;i<repeats;i++){
+        const sample={};
+        for(let j=0;j<configs.length;j++){
+          const c=configs[(i+j)%configs.length],start=performance.now();
+          const value=await c.run();sample[c.name]=performance.now()-start;
+          // Validation deliberately occurs after the timed API has settled.
+          assert.equal(hashValue(value),expected);
+        }
+        row.raw.push(sample);
+      }
+      for(const c of configs){
+        const vals=row.raw.map(r=>r[c.name]);
+        const ci=pairedCI(row.raw,c.name);
+        row.summary[c.name]={p50Ms:percentile(vals,.5),p95Ms:percentile(vals,.95),meanMs:vals.reduce((a,b)=>a+b)/vals.length,
+          latencyRatio95:ci,coarseCriterion:fixture.coarse&&ci[1]<=criteria.coarseLatencyRatioUpper95};
+        if(c.session)row.endStats[c.name]={stats:c.session.stats(),profile:c.session.profile(),diagnostics:c.session.diagnostics()};
+      }
+      row.memoryEnd=process.memoryUsage();
+    }finally{for(const s of sessions)s.close()}
+    report.fixtures.push(row);
+    console.log(fixture.name,JSON.stringify(row.summary));
+    fs.writeFileSync(output,JSON.stringify(report,null,2)+'\n');
+  }
+}finally{fs.rmSync(temp,{recursive:true,force:true})}
+console.log(output);
