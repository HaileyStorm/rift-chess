--- /dev/null
+++ b/tests/workers/f32_finite.bend
@@ -0,0 +1,51 @@
+# Finite arithmetic keeps the source expression tree and fround placement.
+import Base
+
+type FloatPair is Data:
+  FloatPair{left: F32, right: F32}
+
+def identity(value: F32) -> F32:
+  value
+
+def required_identity(value: F32) -> F32:
+  identity@(value)
+
+def iterate(n: Nat, value: F32) -> F32:
+  match n:
+    case 0n: value
+    case 1n+rest: iterate(rest, F32.add(F32.mul(value, 0.5), 1.0))
+
+def pair(+n: Nat, +value: F32) -> FloatPair:
+  a b = iterate(n, value) iterate(n, F32.neg(value))
+  FloatPair{a, b}
+
+def required_pair(n: Nat, value: F32) -> FloatPair:
+  pair@(n, value)
+
+def inverse(value: F32) -> F32:
+  F32.div(1.0, value)
+
+def required_inverse(value: F32) -> F32:
+  inverse@(value)
+
+def representation(value: F32) -> U32:
+  F32{word} = value
+  U32{word}
+
+def forbidden_bits(value: F32) -> U32:
+  representation@(value)
+
+def from_bits(value: U32) -> F32:
+  U32{word} = value
+  F32{word}
+
+def bit_intermediate(value: U32) -> U32:
+  representation(from_bits(value))
+
+def forbidden_intermediate(value: U32) -> U32:
+  bit_intermediate@(value)
+
+def main() -> F32:
+  required_identity(0.0)
+
+#|0.0
