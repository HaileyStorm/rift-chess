@@ -0,0 +1,32 @@
+// Test-only Web Worker interface over actual Node worker_threads. This validates
+// static ESM artifact loading/concurrency, not browser module-worker/CSP support.
+import { Worker } from 'node:worker_threads';
+import { pathToFileURL } from 'node:url';
+import { resolve } from 'node:path';
+export class NodeWorker {
+  constructor(url) {
+    this.maps = new Map();
+    const entry = url instanceof URL ? url.href : pathToFileURL(resolve(String(url))).href;
+    // Node 24 test children expose internal --test-* flags in execArgv; these
+    // are invalid for a Worker and must not make a capable pool unavailable.
+    // The generated worker/bootstrap are .mjs and require no inherited flags.
+    this.worker = new Worker(new URL('./node_bootstrap.mjs', import.meta.url), {workerData: {entry}, execArgv: []});
+    // Node EventEmitter treats an unhandled error as process-fatal, unlike a
+    // terminated browser Worker. Keep a sink through asynchronous termination;
+    // the runtime's registered listener still receives and handles active errors.
+    this.worker.on('error', () => {});
+  }
+  addEventListener(type, callback) {
+    const wrapped = type === 'message' ? (data) => callback({data})
+      : (error) => callback({error, message: error?.message, preventDefault() {}});
+    this.maps.set(callback, [type, wrapped]);
+    this.worker.on(type, wrapped);
+  }
+  removeEventListener(type, callback) {
+    const pair = this.maps.get(callback);
+    if (pair) { this.worker.off(pair[0], pair[1]); this.maps.delete(callback); }
+  }
+  postMessage(message, transfer = []) { this.worker.postMessage(message, transfer); }
+  terminate() { return this.worker.terminate(); }
+}
+export const nodeWorkerFactory = (url, _options) => new NodeWorker(url);
