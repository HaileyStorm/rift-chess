+// A coordinator running inside an existing dedicated worker. Production tests
+// load this as a static module worker; the optional offline harness uses a
+// classic Blob wrapper only to test runtime behavior under restricted browsers.
+self.addEventListener('message',async({data})=>{
+  let session;
+  try{
+    const {createSession}=await import(data.entry);
+    session=createSession({workers:data.workers??2,diagnosticForce:data.force??true,trace:true,transport:data.transport??"clone",
+      ...(data.classic?{workerFactory:(u)=>new Worker(u)}:{})});
+    const value=await session.call(data.root??'marked',data.args??[3n,40000n,42]);
+    self.postMessage({ok:true,value,stats:session.stats(),trace:session.trace()});
+  }catch(error){self.postMessage({ok:false,code:error.code,error:String(error)})}
+  finally{session?.close()}
+});
