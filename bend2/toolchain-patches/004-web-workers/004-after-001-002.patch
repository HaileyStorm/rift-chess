@@ -0,0 +1,33 @@
+# Integer procedural image: closed first-order ADT output, no F32 boundary.
+import Base
+import ./integer_tree.bend as I
+
+type WImage is Data:
+  WPix{rgb: U32}
+  WQua{nw: WImage, ne: WImage, sw: WImage, se: WImage}
+
+def image(depth: Nat, +work: Nat, +seed: U32) -> WImage:
+  match depth:
+    case 0n:
+      WPix{U32.and(I.mix(work, seed), 16777215)}
+    case 1n++rest:
+      nw ne sw se = image(rest, work, seed) image(rest, work, U32.add(seed, 1)) image(rest, work, U32.add(seed, 2)) image(rest, work, U32.add(seed, 3))
+      WQua{nw, ne, sw, se}
+
+def checksum(im: WImage) -> U32:
+  match im:
+    case WPix{rgb}: rgb
+    case WQua{nw, ne, sw, se}:
+      a b c d = checksum(nw) checksum(ne) checksum(sw) checksum(se)
+      U32.add(U32.add(a, b), U32.add(c, d))
+
+def exported(depth: Nat, work: Nat, seed: U32) -> WImage:
+  image!(depth, work, seed)
+
+def read_image(im: WImage) -> U32:
+  checksum!(im)
+
+def main() -> U32:
+  checksum(image(2n, 3n, 7))
+
+#|141953968
