+# Named postfix metadata, rewrite-binder priority, and template elaboration.
+import Base
+
+def identity(x: U32) -> U32:
+  x
+
+def require(x: U32) -> U32:
+  identity!@4(x)
+
+def never(x: U32) -> U32:
+  identity!~(x)
+
+def transform(~f: U32 -> U32, x: U32) -> U32:
+  f(x)
+
+def template_call(x: U32) -> U32:
+  transform@( ~identity, x)
+
+def refl(+x: U32) -> {x == x : U32}:
+  {==}
+
+def rewrite(+x: U32) -> {x == x : U32}:
+  %name@(refl(x)) : {_ == x : U32}; {==}
+
+def main() -> U32:
+  require(7)
+
+#|7
diff --git a/tests/workers/regression_matrix.mjs b/tests/workers/regression_matrix.mjs
new file mode 100644
index 0000000..b7be844
--- /dev/null
+++ b/tests/workers/regression_matrix.mjs
@@ -0,0 +1,65 @@
+/** Differential local compiler/checker matrix against an explicit pristine checkout.
+ * Does not run arbitrary test programs, contact the upstream cluster, or claim
+ * native/device execution. Emission hashes normalize only the checkout path.
+ */
+import fs from 'node:fs';
+import path from 'node:path';
+import {spawnSync} from 'node:child_process';
+import {fileURLToPath,pathToFileURL} from 'node:url';
+import {createHash} from 'node:crypto';
+const SELF=fileURLToPath(import.meta.url),ROOT=fileURLToPath(new URL('../../',import.meta.url));
+const groups=['parse','check','compile','proof','show','comptime'];
+/** Produce a stable successful-emission digest with machine paths removed. */
+const digest=(text,root)=>createHash('sha256').update(text.split(root).join('<ROOT>')).digest('hex');
+/** Run one checker/emitter revision in its own module/memo-table namespace. */
+async function lane(root){
+  const Bend=await import(pathToFileURL(path.join(root,'bend2/bend.ts')));
+  const Comp=await import(pathToFileURL(path.join(root,'bend2/comp.ts')));
+  const rows=[];
+  for(const group of groups){
+    const directory=path.join(root,'tests',group);
+    if(!fs.existsSync(directory))continue;
+    for(const name of fs.readdirSync(directory).filter(n=>n.endsWith('.bend')).sort()){
+      const file='tests/'+group+'/'+name,book=Bend.book_nil(),row={file};
+      if(process.env.BEND_MATRIX_PROGRESS)fs.appendFileSync(process.env.BEND_MATRIX_PROGRESS,file+'\n');
+      try{
+        await Bend.book_load(book,path.join(root,file),'',new Map());
+        Bend.book_valid(book);
+        row.check='valid';row.holes=book.hols;row.open=book.open;
+        if(group==='compile'){
+          Comp.book_owned(book,Comp.SYNTH);
+          for(const [key,emit] of [['js',()=>Comp.js_lib(book,['main'],['main'])],['native',()=>Comp.compile_book(book)]]){
+            try{row[key]=digest(emit(),root)}catch(e){row[key]={error:(e?.$==='Err'?Bend.err_show(e):String(e)).split(root).join('<ROOT>')}}
+          }
+        }
+      }catch(e){row.check=(e?.$==='Err'?Bend.err_show(e):String(e)).split(root).join('<ROOT>')}
+      rows.push(row);
+    }
+  }
+  return rows;
+}
+if(process.argv[2]==='--lane'){
+  const rows=await lane(path.resolve(process.argv[3]));
+  fs.writeFileSync(process.argv[4],JSON.stringify(rows,null,2)+'\n');
+}else{
+  const baseline=process.argv[2],out=process.argv[3];
+  if(!baseline||!out)throw new Error('usage: node --experimental-strip-types tests/workers/regression_matrix.mjs pristine-checkout receipt.json');
+  const destination=path.resolve(out),parent=path.dirname(destination);fs.mkdirSync(parent,{recursive:true});
+  const data=[];
+  for(const [name,root] of [['baseline',path.resolve(baseline)],['stage2',ROOT]]){
+    const dump=path.join(parent,'regression-'+name+'.json');
+    const p=spawnSync(process.execPath,['--stack-size=4096','--experimental-strip-types',SELF,'--lane',root,dump],{encoding:'utf8',timeout:120000,maxBuffer:16*1024*1024});
+    fs.writeFileSync(path.join(parent,'regression-'+name+'.log'),(p.stdout??'')+(p.stderr??''));
+    if(p.status!==0)throw p.error??new Error(name+' lane exited '+p.status);
+    data.push(JSON.parse(fs.readFileSync(dump,'utf8')));
+  }
+  const [before,after]=data,lookup=new Map(after.map(r=>[r.file,r]));
+  const differences=before.flatMap(r=>JSON.stringify(r)===JSON.stringify(lookup.get(r.file))?[]:[{file:r.file,before:r,after:lookup.get(r.file)}]);
+  const report={created:new Date().toISOString(),node:process.version,baseline:'d37909174ebd664338ae3194799a9e0899dedd51',
+    comparison:'Bend parsing/checking and normalized JS/native-C emission; no execution of test programs',
+    laneNodeFlags:['--stack-size=4096','--experimental-strip-types'],
+    baselineFiles:before.length,currentFiles:after.length,groups,passed:differences.length===0&&before.length===after.length,differences};
+  fs.writeFileSync(destination,JSON.stringify(report,null,2)+'\n');
+  console.log(JSON.stringify({files:report.baselineFiles,passed:report.passed,differences:report.differences.length}));
+  if(!report.passed)process.exitCode=1;
+}
diff --git a/tests/workers/runtime_test.mjs b/tests/workers/runtime_test.mjs
new file mode 100644
index 0000000..6dbce83
--- /dev/null
+++ b/tests/workers/runtime_test.mjs
@@ -0,0 +1,228 @@
+// Pure runtime/protocol tests. Mock transport clones messages but is NOT browser
+// or parallel-speed evidence; node_integration.mjs covers actual helper threads.
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {createWorkerSession, serveWorker, snapshotArgs, web_call, web_tail, web_fork} from '../../bend2/web_runtime.js';
+
+const sleep = ms => new Promise(r => setTimeout(r, ms));
+const schemas = [{kind:'u32'}, {kind:'adt', name:'Tree', arms:[
+  {tag:'Leaf', fields:[{name:'value',schema:0}]},
+  {tag:'Node', fields:[{name:'left',schema:1},{name:'right',schema:1}]},
+]}, {kind:'nat'}, {kind:'string'}, {kind:'char'}, {kind:'f32'}, {kind:'bool'}];
+const leaf = value => ({$: 'Leaf', value});
+const node = (left,right) => ({$: 'Node',left,right});
+const sum = t => t.$ === 'Leaf' ? t.value : (sum(t.left)+sum(t.right))>>>0;
+const result = (x,y) => (Math.imul(x,31)+y)>>>0;
+function program() {
+  return {
+    manifest: {protocol:1,program:'test-build',mode:'marked',schemas,
+      sites:[{id:0},{id:1}],exports:{marked:0,unmarked:1,tree:3,closure:5},
+      functions:[
+        {id:0,eligible:true,inputs:[0,0],output:0,arity:2,reachesMark:true},
+        {id:1,eligible:true,inputs:[0,0],output:0,arity:2,reachesMark:false},
+        {id:2,eligible:true,inputs:[0],output:0,arity:1,reachesMark:false},
+        {id:3,eligible:true,inputs:[1],output:0,arity:1,reachesMark:true},
+        {id:4,eligible:true,inputs:[1],output:0,arity:1,reachesMark:false},
+        {id:5,eligible:false,inputs:null,output:null,arity:1,reachesMark:false},
+      ]},
+    serial:[result,result,x=>x,sum,sum,f=>f(3)],
+    coordinators:[
+      function*(x,y){return web_tail(1,[x,y],true)},
+      function*(x,y){const v=yield web_fork(0,[{id:2,args:[x]},{id:2,args:[y]}]);return result(...v)},
+      null,
+      function*(t){const v=yield web_call(4,[t],true);return v},
+      function*(t){if(t.$==='Leaf')return t.value; const v=yield web_fork(1,[{id:4,args:[t.left]},{id:4,args:[t.right]}]);return(v[0]+v[1])>>>0},
+      null,
+    ],
+  };
+}
+
+// Each helper gets its own protocol state and structured-cloned message graph.
+function transport(p, change={}) {
+  const workers=[];
+  function factory() {
+    if(change.construct) throw new Error('denied');
+    let incoming, dead=false;
+    const listeners=new Map();
+    const w={
+      messages:[], terminated:false,
+      addEventListener(k,f){(listeners.get(k)??listeners.set(k,new Set()).get(k)).add(f)},
+      removeEventListener(k,f){listeners.get(k)?.delete(f)},
+      emit(k,data){for(const f of listeners.get(k)??[])f(k==='message'?{data}:data)},
+      listenerCount(){return [...listeners.values()].reduce((n,s)=>n+s.size,0)},
+      postMessage(m){
+        if(change.post && m.kind==='job')throw new Error('post failed');
+        const snapshot=structuredClone(m);w.messages.push(snapshot);
+        if(change.hang && m.kind==='job')return;
+        if(change.noReady && m.kind==='hello')return;
+        setTimeout(()=>{if(!dead)incoming({data:snapshot})},change.delivery??0);
+      },
+      terminate(){dead=true;w.terminated=true},
+    };
+    serveWorker(p,{
+      addEventListener(k,f){assert.equal(k,'message');incoming=f},
+      postMessage(m){
+        let reply=structuredClone(m);
+        if(change.reply)reply=change.reply(reply,w);
+        if(reply===null)return;
+        const delay=reply.kind==='result'?(change.delay?.(reply)??0):0;
+        setTimeout(()=>{if(!dead){w.emit('message',reply);if(change.duplicate && reply.kind==='result')w.emit('message',reply)}},delay);
+      },
+    });
+    workers.push(w);return w;
+  }
+  return {factory,workers};
+}
+function setup(opts={},change={}) {
+  const p=program(), t=transport(p,change);
+  const s=createWorkerSession(p,new URL('file:///ignored.worker.mjs'),{
+    workers:2,workerFactory:t.factory,diagnosticForce:true,
+    startupTimeoutMs:100,taskTimeoutMs:200,...opts});
+  return {p,s,...t};
+}
+function clean(s) {
+  const x=s.stats();
+  assert.equal(x.activeInvocations,0);assert.equal(x.ready,0);assert.equal(x.inFlight,0);
+  assert.equal(x.snapshotBytes,0);assert.equal(x.completedBytes,0);
