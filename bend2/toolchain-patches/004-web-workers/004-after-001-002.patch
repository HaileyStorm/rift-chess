+<!doctype html>
+<html lang="en">
+<meta charset="utf-8">
+<meta name="viewport" content="width=device-width,initial-scale=1">
+<title>Bend Web Workers — stage two</title>
+<style>
+body{font:16px system-ui;max-width:65rem;margin:3rem auto;padding:0 1rem;line-height:1.5}
+button,select{font:inherit;padding:.5rem 1rem}pre{white-space:pre-wrap;overflow-wrap:anywhere}
+</style>
+<h1>Bend Web Workers — stage two</h1>
+<p>Serve this complete folder over HTTP. These are generated static modules,
+including content-bound helper chunks. No source compilation or pool creation occurs at import.</p>
+<p>Require requests real helper execution, not a speedup. Auto learns only from
+actual runs. The initial invocation includes module startup and JIT costs.</p>
+<label>Transport <select id="transport"><option value="clone">Structured clone</option><option value="packed">Typed packed buffers</option></select></label>
+<button id="required">Run required @4 region</button>
+<button id="automatic">Run 12 unmarked auto samples</button>
+<pre id="out">Ready. No helper pool has been constructed.</pre>
+<script type="module">
+import * as policies from './policies/index.mjs';
+import policySerial from './policies/serial.mjs';
+import * as automatic from './automatic/index.mjs';
+import autoSerial from './automatic/serial.mjs';
+const buttons=[...document.querySelectorAll('button')],out=document.querySelector('#out');
+/** Time the public boundary, then validate against the unchanged serial oracle. */
+async function run(required){
+  for(const b of buttons)b.disabled=true;
+  const module=required?policies:automatic;
+  const session=module.createSession({workers:4,trace:true,transport:document.querySelector('#transport').value});
+  try{
+    const args=[3n,200000n,42],samples=[];
+    for(let i=0;i<(required?1:12);i++){
+      const before=session.stats().remoteJobs,start=performance.now();
+      const value=await session.call(required?'require_tree':'unmarked',args);
+      const elapsed=performance.now()-start;
+      const expected=required?policySerial.require_tree(...args):autoSerial.unmarked(...args);
+      if(value!==expected)throw new Error('serial value mismatch');
+      samples.push({invocation:i,value,elapsedMs:elapsed,helperJobs:session.stats().remoteJobs-before});
+      out.textContent=JSON.stringify({samples,stats:session.stats()},null,2);
+    }
+    out.textContent=JSON.stringify({program:module.manifest.program,samples,stats:session.stats(),
+      diagnostics:session.diagnostics(),profiles:session.profile(),trace:session.trace()},null,2);
+  }catch(error){out.textContent=String(error)}
+  finally{session.close();for(const b of buttons)b.disabled=false}
+}
+document.querySelector('#required').addEventListener('click',()=>run(true));
+document.querySelector('#automatic').addEventListener('click',()=>run(false));
+</script>
+</html>
