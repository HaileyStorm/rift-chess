+// Compile real Bend source, load complete static ESM artifact sets and run
+// actual Node worker_threads behind a test-only Web Worker API adapter.
+// This is not a substitute for browser module-worker/hosting acceptance.
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import * as fs from 'node:fs';
+import * as path from 'node:path';
+import * as os from 'node:os';
+import {pathToFileURL,fileURLToPath} from 'node:url';
+import {createHash} from 'node:crypto';
+import {compile,readBook} from '../../gates/workers.mjs';
+import * as Comp from '../../bend2/comp.ts';
+import {nodeWorkerFactory} from './node_adapter.mjs';
+
+const ROOT=fileURLToPath(new URL('../../',import.meta.url));
+const TEMP=fs.mkdtempSync(path.join(os.tmpdir(),'bend-worker-test-'));
+process.on('exit',()=>fs.rmSync(TEMP,{recursive:true,force:true}));
+let next=0;
+async function build(file,roots,mode='marked') {
+  const out=path.join(TEMP,String(++next));
+  const built=await compile(path.join(ROOT,file),out,roots,mode);
+  const {createSession}=await import(pathToFileURL(path.join(out,built.entry)));
+  const serial=(await import(pathToFileURL(path.join(out,'serial.mjs')))).default;
+  return {out,built,createSession,serial};
+}
+const session=(b,opts={})=>b.createSession({workerFactory:nodeWorkerFactory,workers:2,
+  diagnosticForce:true,startupTimeoutMs:10000,taskTimeoutMs:10000,...opts});
+function clear(s) {
+  const x=s.stats();assert.equal(x.activeInvocations,0);assert.equal(x.inFlight,0);assert.equal(x.ready,0);
+  assert.equal(x.snapshotBytes,0);assert.equal(x.completedBytes,0);assert.ok(x.maxInFlight<=2);
+}
+export function referenceMix(n,seed) {
+  let x=seed;for(let i=0;i<Number(n);i++)x=(Math.imul(x,1664525)+1013904223)>>>0;return x;
+}
+export function referenceTree(depth,work,seed) {
+  if(depth===0n)return referenceMix(work,seed);
+  return (Math.imul(referenceTree(depth-1n,work,seed),31)+referenceTree(depth-1n,work,(seed+1)>>>0))>>>0;
+}
+function assertNoSchedulerValues(v) {
+  const q=[v];while(q.length){const x=q.pop();assert.ok(!(x instanceof Promise));
+    if(x&&typeof x==='object'){assert.notEqual(x.$,'$JMP');assert.equal(Object.getOwnPropertySymbols(x).length,0);q.push(...Object.values(x));}}
+}
+
+test('integer source uses two helpers; independent reference and serial oracle agree',async()=>{
+  const b=await build('tests/workers/integer_tree.bend',['main','marked','unmarked']);
+  const s=session(b,{trace:true});try{
+    assert.equal(b.serial.main(),769675072);
+    for(const [d,w,seed] of [[0n,2n,7],[1n,3n,0],[3n,40n,42],[4n,9n,4294967295]]){
+      const got=await s.call('marked',[d,w,seed]);
+      assert.equal(got,referenceTree(d,w,seed));assert.equal(got,b.serial.marked(d,w,seed));
+    }
+    assert.equal(s.stats().remoteJobs,6);assert.equal(new Set(s.trace().filter(x=>x.kind==='result').map(x=>x.worker)).size,2);clear(s);
+    const before=s.stats().remoteJobs;
+    await s.call('unmarked',[3n,10n,1]);assert.equal(s.stats().remoteJobs,before);
+    const concurrently=await Promise.all(Array.from({length:10},(_,i)=>s.call(i%2?'unmarked':'marked',[2n,10n,i])));
+    assert.deepEqual(concurrently,Array.from({length:10},(_,i)=>referenceTree(2n,10n,i)));clear(s);
+  }finally{s.close()}clear(s);
+});
+test('continuations in fields, arguments, matches, local closures and arrays',async()=>{
+  const roots=['constructor','arguments','matched','closure_entry','array_entry','bounded_non_tail','tail_loop','marked_and_unmarked'];
+  const b=await build('tests/workers/continuations.bend',roots);
+  for(const mode of ['marked','auto','off']){
+    const s=session(b,{mode,maxJobs:64});try{
+      for(const name of roots){
+        const args=name==='bounded_non_tail'?[12n,7]:name==='tail_loop'?[10000n,7]:[7];
+        const before=s.stats().remoteJobs;
+        const got=await s.call(name,args);const expected=b.serial[name](...args);
+        assert.deepEqual(got,expected,name+'/'+mode);assertNoSchedulerValues(got);
+        if(mode!=='off')assert.ok(s.stats().remoteJobs>before,'expected resumable source fork: '+name);
+        clear(s);
+      }
+    }finally{s.close()}
+  }
+});
+test('recursive first-order image results, DAG inputs and submission snapshot',async()=>{
+  const b=await build('tests/workers/image_tree.bend',['exported','read_image','main']);
+  assert.ok(b.built.manifest.schemas.some(x=>x.kind==='adt'));
+  const s=session(b);try{
+    const args=[3n,10n,7];const got=await s.call('exported',args);
+    assert.deepEqual(got,b.serial.exported(...args));assertNoSchedulerValues(got);assert.equal(s.stats().remoteJobs,4);clear(s);
+    const pix={$:'WPix',rgb:7},im={$:'WQua',nw:pix,ne:pix,sw:pix,se:pix};
