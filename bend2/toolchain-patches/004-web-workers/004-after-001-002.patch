@@ -0,0 +1,99 @@
+# Stage-two policy scope, witness, cap, and serial-island fixtures.
+import Base
+import ./integer_tree.bend as I
+
+def identity(x: U32) -> U32:
+  x
+
+def require_leaf(work: Nat, seed: U32) -> U32:
+  I.mix@(work, seed)
+
+def require_tree(depth: Nat, work: Nat, seed: U32) -> U32:
+  I.tree@4(depth, work, seed)
+
+def require_bang(depth: Nat, work: Nat, seed: U32) -> U32:
+  I.tree!@4(depth, work, seed)
+
+def never_tree(depth: Nat, work: Nat, seed: U32) -> U32:
+  I.tree!~(depth, work, seed)
+
+def argument_scope(seed: U32) -> U32:
+  identity~(I.mix@(10n, seed))
+
+def argument_never(seed: U32) -> U32:
+  I.mix@(10n, identity~(seed))
+
+def restored(+seed: U32) -> U32:
+  local = I.tree~(2n, 3n, seed)
+  remote = I.tree@(2n, 3n, seed)
+  U32.add(local, remote)
+
+def island(seed: U32) -> U32:
+  I.tree!~(2n, 3n, seed)
+
+def remote_island_body(seed: U32) -> U32:
+  U32.add(island(seed), 1)
+
+def remote_island(seed: U32) -> U32:
+  remote_island_body@(seed)
+
+def nested_body(seed: U32) -> U32:
+  I.mix@1(10n, seed)
+
+def nested_require(seed: U32) -> U32:
+  nested_body@4(seed)
+
+def conflict_body(seed: U32) -> U32:
+  I.mix@(10n, seed)
+
+def conflict(seed: U32) -> U32:
+  conflict_body~(seed)
+
+def conflict_remote_body(seed: U32) -> U32:
+  conflict_body~(seed)
+
+def conflict_remote(seed: U32) -> U32:
+  conflict_remote_body@(seed)
+
+def conditional_body(flag: Bool, seed: U32) -> U32:
+  match flag:
+    case False{}: seed
+    case True{}: I.mix@(10n, seed)
+
+def conditional_never(flag: Bool, seed: U32) -> U32:
+  conditional_body~(flag, seed)
+
+def cap_inner(+depth: Nat, +work: Nat, +seed: U32) -> U32:
+  a b = I.tree@8(depth, work, seed) I.tree@8(depth, work, U32.add(seed, 1))
+  U32.add(a, b)
+
+def cap_outer(depth: Nat, work: Nat, seed: U32) -> U32:
+  cap_inner@2(depth, work, seed)
+
+def sibling_island(+seed: U32) -> U32:
+  left middle right = I.tree(2n, 3n, seed) I.tree!~(2n, 3n, seed) I.tree(2n, 3n, seed)
+  U32.add(U32.add(left, middle), right)
+
+def required_siblings(seed: U32) -> U32:
+  sibling_island@4(seed)
+
+def require_intrinsic(+seed: U32) -> U32:
+  U32.add@(seed, seed)
+
+def required_no_fork(flag: Bool, +seed: U32) -> U32:
+  match flag:
+    case False{}: seed
+    case True{}:
+      left right = I.mix(10n, seed) I.mix(10n, seed)
+      U32.add(left, right)
+
+def conditional_require(flag: Bool, seed: U32) -> U32:
+  required_no_fork@(flag, seed)
+
+def argument_requirement(seed: U32) -> U32:
+  identity@(I.mix@(10n, seed))
+
+def main() -> U32:
+  require_leaf(5n, 7)
+
+#|211918734
