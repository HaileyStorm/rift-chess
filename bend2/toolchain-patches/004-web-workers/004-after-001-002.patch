+/** Focused root-snapshot and auto-policy benchmark using real Node worker_threads.
+ * Run from this checkout with:
+ *   node --experimental-strip-types tests/workers/auto_policy_perf.mjs report.json 8
+ * Outputs are observational. Snapshot time is reported explicitly; no optimized
+ * cost is omitted from end-to-end latency. Current snapshotArgs is the tested
+ * one-pass validator/copier; validate_then_structured_clone is an experiment.
+ * 2026-09-25 Node 24, 12 paired direct samples: experimental/manual mean ratio
+ * was 0.874 for both workloads, but the sparse ratio ranged 0.483..1.765.
+ * End-to-end reruns under active CPU contention were inconclusive, so the
+ * experimental copy path was not retained in web_runtime.js.
+ */
+import fs from 'node:fs';
+import os from 'node:os';
+import path from 'node:path';
+import assert from 'node:assert/strict';
+import {fileURLToPath,pathToFileURL} from 'node:url';
+import {compile} from '../../gates/workers.mjs';
+import {nodeWorkerFactory} from './node_adapter.mjs';
+import {snapshotArgs} from '../../bend2/web_runtime.js';
+
+const ROOT=fileURLToPath(new URL('../../',import.meta.url));
+const output=path.resolve(process.argv[2]??'auto-policy-perf.json');
+const repeats=Number(process.argv[3]??8);
+if(!Number.isInteger(repeats)||repeats<5||repeats>100)throw new Error('repeats must be 5..100');
+const warmups=5, temp=fs.mkdtempSync(path.join(os.tmpdir(),'bend-auto-policy-perf-'));
+const textKey=x=>JSON.stringify(x,(_,v)=>typeof v==='bigint'?v+'n':v);
+function quantile(xs,p){const v=[...xs].sort((a,b)=>a-b);return v[Math.max(0,Math.ceil(p*v.length)-1)]}
+function summarize(xs){return {p50Ms:quantile(xs,.5),p95Ms:quantile(xs,.95),meanMs:xs.reduce((a,b)=>a+b,0)/xs.length,rawMs:xs}}
+
+const report={created:new Date().toISOString(),status:'focused Node worker_threads measurements; not browser acceptance',
+  environment:{node:process.version,v8:process.versions.v8,platform:process.platform,arch:process.arch},
+  method:{warmups,repeats,order:'paired alternating snapshot implementations',
+    snapshotCost:'snapshotMs and direct timings include complete accepted-graph validation and cloning',
+    autoCost:'submit-to-settlement wall time; session.snapshotMs is separately retained and never subtracted'},
+  snapshotFixtures:[],invocations:[]};
+
+try{
+  const roots=['range','dense_image','sum_input','sparse_image'];
+  const built=await compile(path.join(ROOT,'tests/workers/workload_shapes.bend'),path.join(temp,'build'),roots,'auto');
+  const entry=path.join(temp,'build',built.entry);
+  const api=await import(pathToFileURL(entry));
+  const serial=(await import(pathToFileURL(path.join(temp,'build','serial.mjs')))).default;
+  const image=serial.dense_image(7n,0n,7);
+  const imageSchema=built.manifest.functions[built.manifest.exports.dense_image].output;
+  assert.ok(imageSchema>=0,'WImage schema present');
+  const schemaIds=[imageSchema];
+  // Prove malformed host graphs are rejected before the experimental clone
+  // path. The ordinary conformance suite separately covers production copy.
+  const nativeClone=globalThis.structuredClone;let cloneCalls=0;
+  globalThis.structuredClone=function(value){cloneCalls++;return nativeClone(value)};
+  const validateThenClone=value=>{
+    const scan=snapshotArgs([value],schemaIds,built.manifest.schemas,{},false);
+    return {...scan,values:globalThis.structuredClone(scan.values)};
+  };
+  try{
+    let getterCalls=0;
+    const accessor={$:'WPix'};
+    Object.defineProperty(accessor,'rgb',{enumerable:true,get(){getterCalls++;return 1}});
+    const leaf={$:'WPix',rgb:2};
+    const cycle={$:'WQua',nw:null,ne:leaf,sw:leaf,se:leaf};cycle.nw=cycle;
+    const exotic=Object.assign(Object.create({}),{$:'WPix',rgb:3});
+    for(const invalid of [accessor,cycle,exotic]){
+      const before=cloneCalls;
+      assert.throws(()=>validateThenClone(invalid));
+      assert.equal(cloneCalls,before,'invalid graph must be rejected before clone');
+    }
+    assert.equal(getterCalls,0,'validation must not invoke getters');
+    const shared={$:'WQua',nw:leaf,ne:leaf,sw:leaf,se:leaf};
+    const preserved=validateThenClone(shared).values[0];
+    assert.equal(preserved.nw,preserved.ne,'native clone preserves DAG sharing');
+    assert.notStrictEqual(preserved.nw,leaf,'native clone does not alias host objects');
+    leaf.rgb=11;assert.equal(preserved.nw.rgb,2,'accepted snapshot is temporally isolated');
+    assert.equal(cloneCalls,1);
+    const production=snapshotArgs([shared],schemaIds,built.manifest.schemas).values[0];
+    assert.notStrictEqual(production,shared,'production snapshot is detached');
+    assert.equal(production.nw,production.ne,'production snapshot preserves DAG sharing');
+  }finally{globalThis.structuredClone=nativeClone}
+  const snapshotWays=[
+    ['integrated_validate_copy',()=>snapshotArgs([image],schemaIds,built.manifest.schemas,{},true)],
+    ['validate_then_structured_clone',()=>{
+      const scan=snapshotArgs([image],schemaIds,built.manifest.schemas,{},false);
+      return {...scan,values:globalThis.structuredClone(scan.values)};
+    }],
+  ];
+  for(const [name,fn] of snapshotWays){
+    const result=fn();
+    assert.deepEqual(result.values,[image]);
+    assert.notStrictEqual(result.values[0],image,'snapshot detaches host-owned graph');
+    assert.notStrictEqual(result.values[0].nw,image.nw,'snapshot detaches nested nodes');
+  }
+  const snapshotCount=Math.min(12,repeats+4);
+  for(const [fixture,source] of [['large_reduction_input',image],['sparse_update_input',image]]){
+    const row={name:fixture,treeDepth:7,nodeCount:21845,bytesEstimate:null,ways:{}};
+    // Warm each implementation evenly before alternating measured samples.
+    for(let i=0;i<warmups;i++)for(const [,fn] of snapshotWays)fn();
+    const samples=Object.fromEntries(snapshotWays.map(([n])=>[n,[]]));
+    for(let i=0;i<snapshotCount;i++)for(let j=0;j<snapshotWays.length;j++){
+      const [name,fn]=snapshotWays[(i+j)%snapshotWays.length],start=performance.now();
+      const snap=fn();samples[name].push(performance.now()-start);
+      row.bytesEstimate??=snap.bytes;
+      assert.equal(textKey(snap.values),textKey([source]));
+    }
+    for(const [name,xs] of Object.entries(samples))row.ways[name]=summarize(xs);
+    report.snapshotFixtures.push(row);
+  }
+
+  const cases=[
+    {name:'large_input_cheap_reduction',root:'sum_input',args:[image]},
+    {name:'repeated_immutable_sparse_update',root:'sparse_image',args:[image,2n]},
+    {name:'dense_integer_small_result',root:'range',args:[3n,100000n,7]},
+    {name:'dense_image_materialized_result',root:'dense_image',args:[4n,3000n,7]},
+  ];
+  for(const fixture of cases){
+    const expected=textKey(serial[fixture.root](...fixture.args));
+    const session=api.createSession({workers:4,workerFactory:nodeWorkerFactory,startupTimeoutMs:20000,taskTimeoutMs:30000,mode:'auto'});
+    const values=[];
+    try{
+      for(let i=0;i<warmups;i++)assert.equal(textKey(await session.call(fixture.root,fixture.args)),expected);
+      let previous=0;
+      for(let i=0;i<repeats;i++){
+        const start=performance.now(),value=await session.call(fixture.root,fixture.args);
+        values.push(performance.now()-start);assert.equal(textKey(value),expected);
+        previous+=session.stats().remoteJobs;
+      }
+      const stats=session.stats();
+      report.invocations.push({name:fixture.name,legacyMs:summarize(Array.from({length:repeats},()=>{
+          const start=performance.now(),value=serial[fixture.root](...fixture.args);
+          assert.equal(textKey(value),expected);return performance.now()-start;
+        })),autoMs:summarize(values),snapshotMsTotal:stats.snapshotMs,snapshotMsPerCall:stats.snapshotMs/(warmups+repeats),
+        remoteJobs:stats.remoteJobs,localCalls:stats.localCalls,diagnostics:session.diagnostics()});
+    }finally{session.close()}
+  }
+  fs.mkdirSync(path.dirname(output),{recursive:true});fs.writeFileSync(output,JSON.stringify(report,null,2)+'\n');
+  console.log(JSON.stringify({output,snapshots:report.snapshotFixtures.map(x=>({name:x.name,custom:x.ways.integrated_validate_copy.p50Ms,clone:x.ways.validate_then_structured_clone.p50Ms})),
+    invocations:report.invocations.map(x=>({name:x.name,legacyP50:x.legacyMs.p50Ms,autoP50:x.autoMs.p50Ms,snapshotPerCall:x.snapshotMsPerCall,remoteJobs:x.remoteJobs}))},null,2));
+}finally{fs.rmSync(temp,{recursive:true,force:true})}
