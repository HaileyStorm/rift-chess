+// End-to-end test of Bun's HTML output plus the compiler's external static
+// module-worker artifacts. Browser execution is included when Playwright and
+// Chrome are installed; the bundle/rollback checks always run with pinned Bun.
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import * as fs from 'node:fs';
+import * as http from 'node:http';
+import * as os from 'node:os';
+import * as path from 'node:path';
+import {spawnSync} from 'node:child_process';
+import {fileURLToPath} from 'node:url';
+
+const HERE=fileURLToPath(new URL('.',import.meta.url));
+const WORKTREE=path.resolve(HERE,'../..');
+const TEMP=fs.mkdtempSync(path.join(os.tmpdir(),'bend-html-workers-'));
+process.on('exit',()=>fs.rmSync(TEMP,{recursive:true,force:true}));
+function workspaceRoot(at){
+  for(let dir=at;;dir=path.dirname(dir)){
+    if(fs.existsSync(path.join(dir,'bend2','TOOLCHAIN.json'))&&fs.existsSync(path.join(dir,'.artifacts')))
+      return dir;
+    const parent=path.dirname(dir);if(parent===dir)throw new Error('workspace root not found');
+  }
+}
+const ROOT=workspaceRoot(WORKTREE);
+const pin=JSON.parse(fs.readFileSync(path.join(ROOT,'bend2/TOOLCHAIN.json'),'utf8'));
+const bun=process.env.BUN_BIN||path.join(ROOT,'.artifacts/toolchains/runtime/node_modules/@oven',
+  process.platform==='win32'?'bun-windows-x64/bin/bun.exe':`bun-${process.platform}-${process.arch}/bin/bun`);
+const page=path.join(HERE,'worker_bundle.html');
+const library=path.join(HERE,'policies.bend');
+const output=path.join(TEMP,'nested','site');
+const plainPage=path.join(TEMP,'plain.html');
+const plainScript=path.join(TEMP,'plain.js');
+const plainBend=path.join(TEMP,'plain_lib.bend');
+
+function invoke(args){
+  const child=spawnSync(bun,[path.join(WORKTREE,'bend2/main.ts'),...args],{
+    cwd:ROOT,encoding:'utf8',timeout:120000,
+    env:{...process.env,BEND_NO_TELEMETRY:'1'},
+  });
+  if(child.error)throw child.error;
+  return child;
+}
+const mime=file=>file.endsWith('.html')?'text/html; charset=utf-8':
+  /\.(?:m?js)$/.test(file)?'text/javascript; charset=utf-8':
+  file.endsWith('.json')?'application/json':'application/octet-stream';
+
+test('Bun bundles an explicit worker library as nested static ESM and publishes atomically',async t=>{
+  if(!fs.existsSync(bun))return t.skip('pinned Bun runtime is unavailable: '+bun);
+  const version=spawnSync(bun,['--version'],{encoding:'utf8'});
+  assert.equal(version.status,0,version.stderr);
+  assert.equal(version.stdout.trim(),pin.bunVersion,'integration must use the pinned Bun');
+
+  const built=invoke([page,'--web-library',library,'--web-exports=require_tree',
+    '-o',output]);
+  assert.equal(built.status,0,built.stderr+'\n'+built.stdout);
+  const workerRoots=fs.readdirSync(path.join(output,'workers'));
+  assert.equal(workerRoots.length,1);
