+# Standalone adaptive and transport workloads, not application-specific tuning.
+import Base
+import ./integer_tree.bend as I
+import ./image_tree.bend as M
+
+def range(depth: Nat, work: Nat, seed: U32) -> U32:
+  I.tree(depth, work, seed)
+
+def required_range(depth: Nat, work: Nat, seed: U32) -> U32:
+  I.tree@4(depth, work, seed)
+
+def dense_image(depth: Nat, work: Nat, seed: U32) -> M.WImage:
+  M.image(depth, work, seed)
+
+def required_image(depth: Nat, work: Nat, seed: U32) -> M.WImage:
+  M.image@4(depth, work, seed)
+
+def sum_input(image: M.WImage) -> U32:
+  M.checksum(image)
+
+def required_sum(image: M.WImage) -> U32:
+  M.checksum@4(image)
+
+def identity_image(image: M.WImage) -> M.WImage:
+  image
+
+# Only the northwest spine changes. Other quadrants return their exact input.
+def sparse(image: M.WImage, work: Nat) -> M.WImage:
+  match image:
+    case M.WPix{rgb}: M.WPix{I.mix(work, rgb)}
+    case M.WQua{nw, ne, sw, se}:
+      a b c d = sparse(nw, work) identity_image(ne) identity_image(sw) identity_image(se)
+      M.WQua{a, b, c, d}
+
+def sparse_image(image: M.WImage, work: Nat) -> M.WImage:
+  sparse(image, work)
+
+def required_sparse(image: M.WImage, work: Nat) -> M.WImage:
+  sparse@4(image, work)
+
+# Source-independent candidates with intentionally skewed compute costs.
+def skew(+work: Nat, +seed: U32) -> U32:
+  a b c d = I.mix(work, seed) I.mix(0n, seed) I.mix(1n, seed) I.mix(2n, seed)
+  U32.add(U32.add(a, b), U32.add(c, d))
+
+def required_skew(work: Nat, seed: U32) -> U32:
+  skew@4(work, seed)
+
+# Deliberately sequential: no worker frontier may be inferred from this chain.
+def sequential(n: Nat, +work: Nat, seed: U32) -> U32:
+  match n:
+    case 0n: seed
+    case 1n++rest:
+      next = I.mix(work, seed)
+      sequential(rest, work, next)
+
+def main() -> U32:
+  range(2n, 5n, 7)
+
