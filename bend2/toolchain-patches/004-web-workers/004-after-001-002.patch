+#!/usr/bin/env python3
+"""Real browser runner; no npm toolchain. Requires the Python playwright package.
+
+Production route (default): static same-origin ESM module workers, nested prefix,
+content-hashed chunks, page and existing dedicated-worker callers.
+--blob-classic: a separately labelled, offline runtime conformance experiment.
+It deliberately bundles the serial/runtime source into a CLASSIC worker for
+restricted environments. It cannot establish production module/CSP acceptance.
+
+Example:
+  node --experimental-strip-types gates/workers.mjs demo /tmp/bend-demo
+  python tests/workers/browser_runner.py --artifacts /tmp/bend-demo \
+      --browser chromium --output browser.json
+"""
+import argparse
+import functools
+import http.server
+import json
+import pathlib
+import shutil
+import tempfile
+import threading
+from playwright.sync_api import sync_playwright
+
+CHECKS = r'''async ({sources, classic, callerSource}) => {
+  const urls=[],tests=[],sessions=[];
+  const makeBlob=s=>{const u=URL.createObjectURL(new Blob([s],{type:'text/javascript'}));urls.push(u);return u};
+  const check=(ok,message)=>{if(!ok)throw new Error(message)};
+  const pause=ms=>new Promise(r=>setTimeout(r,ms));
+  const mix=(n,seed)=>{let x=seed;for(let i=0;i<Number(n);i++)x=(Math.imul(x,1664525)+1013904223)>>>0;return x};
+  const tree=(d,w,x)=>d===0n?mix(w,x):(Math.imul(tree(d-1n,w,x),31)+tree(d-1n,w,(x+1)>>>0))>>>0;
+  const run=async(name,fn)=>{try{tests.push({name,ok:true,detail:await fn()})}catch(e){tests.push({name,ok:false,error:String(e),code:e.code})}};
+  async function load(name){
+    const f=sources[name],a=f.artifacts;let entry,serialURL;
+    if(classic){
+      const runtime=makeBlob(f.runtime);
+      const program=makeBlob(f.program.replaceAll('./'+a.runtime,runtime));
+      // Test-only bundling, never used by compiler output or production loader.
+      const worker=makeBlob((f.runtime+'\n'+f.program).replace(/^import .*;$/gm,'').replace(/^export /gm,'')+'\nserveWorker({manifest,serial,coordinators});');
+      entry=makeBlob(f.entry.replaceAll('./'+a.runtime,runtime).replaceAll('./'+a.program,program).replaceAll('./'+a.worker,worker));
+      serialURL=makeBlob(f.serial);
+    }else{entry=new URL('./'+name+'/index.mjs',location.href).href;serialURL=new URL('./'+name+'/serial.mjs',location.href).href}
+    return {entry,...await import(entry),serial:(await import(serialURL)).default};
+  }
+  const integer=await load('integer'),image=await load('image'),cont=await load('continuations');
