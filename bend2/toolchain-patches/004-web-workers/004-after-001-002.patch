+#!/usr/bin/env node
+// Local-only worker gate; never contacts the upstream mini cluster.
+// Node >=22.6: node --experimental-strip-types gates/workers.mjs compile ...
+import * as fs from 'node:fs';
+import * as path from 'node:path';
+import {spawnSync} from 'node:child_process';
+import {fileURLToPath} from 'node:url';
+import {pathToFileURL} from 'node:url';
+import * as Bend from '../bend2/bend.ts';
+import * as Comp from '../bend2/comp.ts';
+import {resolve_base_foreign, write_worker_files} from '../bend2/main.ts';
+
+/** Load and check a closed source book, then apply the existing ownership pass. */
+export async function readBook(file) {
+  const book = Bend.book_nil();
+  // The Bend import resolver uses POSIX path joins for source modules.
+  await Bend.book_load(book, path.resolve(file).replaceAll('\\', '/'), '', new Map());
+  resolve_base_foreign(book);
+  Bend.book_valid(book);
+  Comp.book_owned(book, Comp.SYNTH);
+  if (book.hols + book.open) throw new Error('unfilled source obligations');
+  return book;
+}
+/** Emit a complete worker artifact set and test-only serial oracle into an empty directory. */
+export async function compile(file, directory, roots, mode = 'auto', policy = undefined) {
+  if (fs.existsSync(directory) && fs.readdirSync(directory).length)
+    throw new Error('worker output directory must be empty: ' + directory);
+  const book = await readBook(file);
+  const serial = Comp.js_lib(book, roots, roots, {internal:true});
+  const build = Comp.js_worker_lib(book, roots, {mode,policy});
+  write_worker_files(build, directory);
+  fs.writeFileSync(path.join(directory, 'serial.mjs'), serial);
+  fs.writeFileSync(path.join(directory, 'diagnostics.json'), JSON.stringify(build.diagnostics, null, 2)+'\n');
+  return build;
+}
+if (process.argv[1] && import.meta.url === pathToFileURL(path.resolve(process.argv[1])).href) {
+  try {
+    const [command, file, out, names, mode, policy] = process.argv.slice(2);
+    if (command === 'test') {
+      const root=fileURLToPath(new URL('../',import.meta.url));
+      const result=spawnSync(process.execPath,['--experimental-strip-types','--test',
+        'tests/workers/runtime_test.mjs','tests/workers/node_integration.mjs',
+        'tests/workers/stage2_test.mjs','tests/workers/html_bundle.mjs'],{cwd:root,stdio:'inherit'});
+      process.exit(result.status ?? 1);
+    }
+    if (command === 'demo') {
+      if (!file) throw new Error('demo requires a new output directory');
+      const dest=path.resolve(file),root=fileURLToPath(new URL('../',import.meta.url));
+      if (fs.existsSync(dest) && fs.readdirSync(dest).length) throw new Error('demo output directory must be empty');
+      await compile(path.join(root,'tests/workers/integer_tree.bend'),path.join(dest,'integer'),['main','marked','unmarked'],'marked');
+      await compile(path.join(root,'tests/workers/image_tree.bend'),path.join(dest,'image'),['exported','read_image','main'],'marked');
+      await compile(path.join(root,'tests/workers/continuations.bend'),path.join(dest,'continuations'),['constructor','arguments','matched','closure_entry','array_entry','bounded_non_tail','tail_loop','marked_and_unmarked'],'marked');
+      await compile(path.join(root,'tests/workers/integer_tree.bend'),path.join(dest,'automatic'),['marked','unmarked'],'auto');
+      await compile(path.join(root,'tests/workers/policies.bend'),path.join(dest,'policies'),
+        ['require_leaf','require_tree','never_tree','argument_scope','argument_requirement','restored','remote_island','nested_require','conflict','conflict_remote','cap_outer','conditional_never'],'required-only');
+      await compile(path.join(root,'tests/workers/f32_finite.bend'),path.join(dest,'floats'),
+        ['required_identity','required_pair','required_inverse'],'required-only');
+      fs.copyFileSync(path.join(root,'tests/workers/browser_caller.mjs'),path.join(dest,'browser_caller.mjs'));
+      fs.copyFileSync(path.join(root,'tests/workers/index.html'),path.join(dest,'index.html'));
+      console.log('demo: '+dest);process.exit(0);
+    }
+    if (command !== 'compile' || !file || !out || !names)
+      throw new Error('usage: node --experimental-strip-types gates/workers.mjs compile file.bend outdir export1,export2 [auto|required-only|off|marked] [strict|permissive]; or test; or demo outdir');
+    const build = await compile(file, out, names.split(','), mode, policy);
+    console.log(JSON.stringify({program: build.manifest.program, sites: build.manifest.sites,
+      functions: build.manifest.functions, entry: path.join(out, build.entry)}, null, 2));
+  } catch (e) {
+    console.error(e?.$ === 'Err' ? Bend.err_show(e) : e);
+    process.exitCode = 1;
+  }
+}
