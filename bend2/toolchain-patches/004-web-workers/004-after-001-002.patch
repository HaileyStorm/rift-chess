--- /dev/null
+++ b/tests/workers/node_bootstrap.mjs
@@ -0,0 +1,11 @@
+import {parentPort, workerData} from 'node:worker_threads';
+let receive;
+const pending = [];
+parentPort.on('message', data => receive ? receive({data}) : pending.push(data));
+globalThis.addEventListener = (type, listener) => {
+  if (type !== 'message' || receive) throw new Error('test adapter accepts one message listener');
+  receive = listener;
+  for (const data of pending.splice(0)) receive({data});
+};
+globalThis.postMessage = (data, transfer = []) => parentPort.postMessage(data, transfer);
+await import(workerData.entry);
