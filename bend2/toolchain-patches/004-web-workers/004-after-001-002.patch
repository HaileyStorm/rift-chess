+# Source-position coverage: constructors, calls, matches, closures, arrays,
+# non-tail recursion and repeated marked/unmarked calls to the same function.
+import Base
+import ./integer_tree.bend as I
+
+type PairU is Data:
+  PairU{left: U32, right: U32}
+
+def total(p: PairU) -> U32:
+  PairU{left, right} = p
+  U32.add(left, right)
+
+def constructor(+seed: U32) -> PairU:
+  PairU{I.marked(2n, 4n, seed), I.marked(1n, 3n, seed)}
+
+def arguments(+seed: U32) -> U32:
+  U32.add(I.marked(2n, 4n, seed), I.marked(1n, 3n, seed))
+
+def matched_body(p: PairU) -> U32:
+  PairU{left, right} = p
+  U32.add(I.marked(2n, 2n, left), right)
+
+def matched(seed: U32) -> U32:
+  matched_body(constructor(seed))
+
+def capture(seed: U32) -> U32 -> U32:
+  x => U32.add(seed, x)
+
+def local_closure(seed: U32) -> U32:
+  f = capture(seed)
+  left right = I.tree(2n, 4n, 1) I.tree(2n, 4n, 2)
+  f(U32.add(left, right))
+
+def closure_entry(seed: U32) -> U32:
+  local_closure!(seed)
+
+def array_tail(left: U32, right: U32, pair: Array<U32> & U32) -> U32:
+  (a, y) = pair
+  U32.add(U32.add(left, right), y)
+
+def array_head(pair: Array<U32> & U32) -> U32:
+  (a, x) = pair
+  left right = I.tree(2n, 4n, x) I.tree(2n, 4n, 2)
+  array_tail(left, right, Array.get(U32, a, 1))
+
+def local_array(a: Array<U32>) -> U32:
+  array_head(Array.get(U32, a, 0))
+
+def array_entry(seed: U32) -> U32:
+  local_array!(ANode{ALeaf{seed}, ALeaf{9}})
+
+def bounded_non_tail(n: Nat, +seed: U32) -> U32:
+  match n:
+    case 0n: seed
+    case 1n+rest:
+      U32.add(I.marked(1n, 2n, seed), bounded_non_tail(rest, seed))
+
+def tail_loop(n: Nat, +seed: U32) -> U32:
+  match n:
+    case 0n: I.marked(1n, 2n, seed)
+    case 1n+rest: tail_loop(rest, seed)
+
+def marked_and_unmarked(+seed: U32) -> U32:
+  a = I.tree(2n, 4n, seed)
+  b = I.tree!(2n, 4n, seed)
+  U32.add(a, b)
+
+def main() -> U32:
+  arguments(7)
+
