@@ -0,0 +1,119 @@
+/** Paired stage-two workload/transport measurements using real Node helper threads.
+ * This is not production browser acceptance. Includes root snapshots, runtime
+ * validation, packing, replies and joins in every asynchronous invocation timer.
+ */
+import fs from 'node:fs';
+import os from 'node:os';
+import path from 'node:path';
+import assert from 'node:assert/strict';
+import {fileURLToPath,pathToFileURL} from 'node:url';
+import {compile} from '../../gates/workers.mjs';
+import {nodeWorkerFactory} from '../../tests/workers/node_adapter.mjs';
+
+const ROOT=fileURLToPath(new URL('../../',import.meta.url));
+const output=path.resolve(process.argv[2]??'stage2-benchmark.json');
+const repeats=Number(process.argv[3]??12);
+if(!Number.isInteger(repeats)||repeats<8||repeats>100)throw new Error('repeats must be 8..100');
+const temp=fs.mkdtempSync(path.join(os.tmpdir(),'bend-web-stage2-bench-'));
+const roots=['range','required_range','dense_image','required_image','sum_input','required_sum','identity_image','sparse_image','required_sparse','skew','required_skew','sequential'];
+/** Stable value check performed after, never inside, the timed invocation. */
+const valueKey=x=>JSON.stringify(x,(_,v)=>typeof v==='bigint'?v+'n':v);
+/** Empirical nearest-rank quantile of a nonempty numeric sample. */
+function quantile(values,p){const v=[...values].sort((a,b)=>a-b);return v[Math.max(0,Math.ceil(p*v.length)-1)]}
+let seed=0x718ff;
+/** Deterministic resampling makes interval calculation reproducible. */
+function random(){seed=(Math.imul(seed,1664525)+1013904223)>>>0;return seed/2**32}
+/** Paired bootstrap ratio of mean elapsed times; no normality assumption. */
+function interval(rows,numerator,denominator='legacy'){
+  const samples=[];
+  for(let i=0;i<2000;i++){
+    let a=0,b=0;
+    for(let j=0;j<rows.length;j++){const row=rows[Math.floor(random()*rows.length)];a+=row[numerator];b+=row[denominator]}
+    samples.push(a/b);
+  }
+  return [quantile(samples,.025),quantile(samples,.975)];
+}
+const report={created:new Date().toISOString(),status:'informative Node worker_threads measurements; not browser acceptance',
+  criteria:{warmups:5,repeats,order:'rotating interleaved',bootstrapResamples:2000,coarseRatioUpper95:.8,coarseWinsRequired:2,
+    tinyAddedP95Ms:.5,transportDecision:'keep structured clone as default; report paired packed/clone ratios without hiding losses'},
+  environment:{node:process.version,v8:process.versions.v8,platform:process.platform,arch:process.arch,cpu:os.cpus()[0]?.model,
+    logicalCPUs:os.cpus().length,availableParallelism:os.availableParallelism()},
+  memoryMethod:'process.memoryUsage(): RSS is the whole benchmark process, including co-resident helper pools; heapUsed is coordinator-only. Runtime retained-byte counters are estimates, not process memory or peak task allocation.',
+  fixtures:[],loadShift:[]};
+/** Persist raw samples after every completed family, including partial runs. */
+function save(){fs.mkdirSync(path.dirname(output),{recursive:true});fs.writeFileSync(output,JSON.stringify(report,null,2)+'\n')}
+try{
+  const start=performance.now(),built=await compile(path.join(ROOT,'tests/workers/workload_shapes.bend'),temp,roots,'auto');
+  report.compileMs=performance.now()-start;
+  const importStart=performance.now();
+  const api=await import(pathToFileURL(path.join(temp,built.entry)));
+  const serial=(await import(pathToFileURL(path.join(temp,'serial.mjs')))).default;
+  report.importMs=performance.now()-importStart;report.program=built.manifest.program;
+  const image=serial.dense_image(7n,0n,7);
+  const families=[
+    {name:'dense_integer_small_result',root:'range',required:'required_range',args:[3n,100000n,7],coarse:true},
+    {name:'dense_image_materialized_result',root:'dense_image',required:'required_image',args:[4n,3000n,7],coarse:true},
+    {name:'large_output_trivial_work',root:'dense_image',required:'required_image',args:[7n,0n,7]},
+    {name:'large_input_cheap_reduction',root:'sum_input',required:'required_sum',args:[image]},
+    {name:'repeated_immutable_sparse_update',root:'sparse_image',required:'required_sparse',args:[image,2n]},
+    {name:'skewed_independent_candidates',root:'skew',required:'required_skew',args:[400000n,7]},
+    {name:'tiny_fork_storm',root:'range',required:'required_range',args:[6n,0n,7]},
+    {name:'sequential_chain',root:'sequential',args:[3n,30000n,7]},
+  ];
+  for(const family of families){
+    const expected=valueKey(serial[family.root](...family.args));
+    const configs=[{name:'legacy'},{name:'off0',workers:0,mode:'off'},
+      {name:'auto2',workers:2,mode:'auto'},{name:'auto4',workers:4,mode:'auto'},
+      {name:'restricted_unmarked',workers:4,mode:'required-only',policy:'strict'}];
+    if(family.required)configs.push(
+      {name:'require1',workers:1,mode:'required-only',policy:'strict',root:family.required},
+      {name:'require2',workers:2,mode:'required-only',policy:'strict',root:family.required},
+      {name:'require4',workers:4,mode:'required-only',policy:'strict',root:family.required},
+      {name:'packed4',workers:4,mode:'required-only',policy:'strict',root:family.required,transport:'packed'});
+    const row={name:family.name,coarse:!!family.coarse,inputDescription:family.args.map(x=>typeof x==='object'?'immutable full quadtree depth 7':String(x)),
+      outputTextBytes:Buffer.byteLength(expected),cold:{},raw:[],summary:{},end:{},memoryBefore:process.memoryUsage()};
+    try{
+      for(const c of configs){
+        if(c.name!=='legacy')c.session=api.createSession({workerFactory:nodeWorkerFactory,startupTimeoutMs:20000,taskTimeoutMs:30000,...c});
+        c.run=()=>c.session?c.session.call(c.root??family.root,family.args):serial[family.root](...family.args);
+        const t=performance.now(),value=await c.run();row.cold[c.name]=performance.now()-t;
+        assert.equal(valueKey(value),expected);
+      }
+      for(let i=0;i<report.criteria.warmups;i++)for(const c of configs)assert.equal(valueKey(await c.run()),expected);
+      for(let i=0;i<repeats;i++){
+        const sample={};
+        for(let j=0;j<configs.length;j++){
+          const c=configs[(i+j)%configs.length],before=c.session?.stats().remoteJobs??0,t=performance.now();
+          const value=await c.run();sample[c.name]=performance.now()-t;
+          sample[c.name+'_remoteJobs']=(c.session?.stats().remoteJobs??0)-before;
+          assert.equal(valueKey(value),expected);
+        }
+        row.raw.push(sample);
+      }
+      for(const c of configs){
+        const times=row.raw.map(x=>x[c.name]),ci=interval(row.raw,c.name);
+        row.summary[c.name]={p50Ms:quantile(times,.5),p95Ms:quantile(times,.95),meanMs:times.reduce((a,b)=>a+b,0)/times.length,
+          latencyRatio95:ci,measuredRemoteJobs:row.raw.reduce((n,x)=>n+x[c.name+'_remoteJobs'],0),
+          coarseCriterion:!!family.coarse&&ci[1]<=report.criteria.coarseRatioUpper95};
+        if(c.session)row.end[c.name]={stats:c.session.stats(),profile:c.session.profile(),diagnostics:c.session.diagnostics()};
+      }
+      if(family.required)row.packedOverCloneRatio95=interval(row.raw,'packed4','require4');
+      row.memoryAfter=process.memoryUsage();
+    }finally{for(const c of configs)c.session?.close()}
+    report.fixtures.push(row);save();
+    console.log(family.name,JSON.stringify(row.summary));
+  }
+  // Same site and scalar shape, changing actual work. No seed-value profile key.
+  const s=api.createSession({workers:4,workerFactory:nodeWorkerFactory});
+  try{
+    for(const [phase,work,count] of [['dense',100000n,12],['tiny',0n,12],['dense_again',100000n,18]]){
+      for(let i=0;i<count;i++){
+        const before=s.stats().remoteJobs,t=performance.now();const value=await s.call('range',[3n,work,7]);
+        const ms=performance.now()-t;assert.equal(value,serial.range(3n,work,7));
+        report.loadShift.push({phase,index:i,ms,remoteJobs:s.stats().remoteJobs-before,profile:s.profile()});
+      }
+    }
+    report.loadShiftEnd=s.stats();
+  }finally{s.close()}
+  save();console.log(output);
+}finally{fs.rmSync(temp,{recursive:true,force:true})}
