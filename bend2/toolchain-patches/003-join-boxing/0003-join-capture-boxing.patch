+// Move wide live values through a continuation as one owned constructor word.
+// The source binding retains its type; val_to unpacks it at its next use. This
+// only compresses captured values, never a callee's raw return ABI.
+function box_join_captures(fl: File, live: [Probe, Bind][], returns: number):
+  [Probe, Bind][] {
+  let words = returns + live.reduce((n, [, b]) => n + b.val.ws.length, 0);
+  if (words <= WIDE) {
+    return live;
+  }
+  const out = [...live];
+  const order = [...out.keys()].sort((a, b) =>
+    out[b][1].val.ws.length - out[a][1].val.ws.length);
+  for (const i of order) {
+    const [p, b] = out[i];
+    if (words <= WIDE) {
+      break;
+    }
+    if (b.val.ws.length <= 1) {
+      break;
+    }
+    const boxed = val_hold(fl, val_to(fl, b.val, BOX), "join");
+    words -= b.val.ws.length - 1;
+    out[i] = [p, { ...b, val: boxed }];
+    fl.uses.set(p, out[i][1]);
+  }
+  return out;
+}
