+
+// Typed structural report. It never invokes the emitter or executes main.
+// A traversed site may be dead or disappear when the emitter folds a constant.
+export function explain_layout(book: Bend.Book, names: Name[]): string {
+  const own = [...new Set(names)].filter((k) => book.tlds[k] !== undefined
+    && book.tlds[k].b !== true);
+  const cb = carb_book(book, own);
+  const declarations = own.map((k) => {
+    const tld = cb.book.tlds[k];
+    if (tld.$ === "ADT") {
+      const constructors = tld.c.map((c) => {
+        const node = lay_node(cb.book, c.k);
+        return { name: c.k, node: lay_report(node),
+          fields: node.arms![0].fs.map((f) => ({ offset: f.at,
+            layout: lay_report(f.lay) })) };
+      });
+      return { kind: "type", name: k, parameters: tld.n,
+        value: tld.n === 0 ? lay_report(lay_of(cb.book, Bend.ADT(k, [])))
+          : null, constructors };
+    }
+    const sig = sig_def(cb, k);
+    const sites: ({ kind: "parallel-let"; calls: string[];
+      branches: number; resultWords: number[]; totalResultWords: number }
+      | { kind: "bang-call"; callee: string;
+        argumentWords: number[]; resultWords: number })[] = [];
+    if (done_live(tld)) {
+      term_any(cb, tld.h as HTerm, (s) => {
+        if (s.$ === "Let") {
+          const live = let_live(cb, s);
+          const calls = s.v.filter((_, i) => live[i]).map((v) =>
+            call_kind(cb, v)?.k ?? null);
+          if (calls.length > 1 && calls.every((c) => c !== null)) {
+            const named = calls as string[];
+            const resultWords = named.map((c) => sig_def(cb, c).ret.ks.length);
+            sites.push({ kind: "parallel-let", calls: named,
+              branches: named.length, resultWords,
+              totalResultWords: resultWords.reduce((a, b) => a + b, 0) });
+          }
+        } else if (s.$ === "Ref" && s.b) {
+          const sig = sig_def(cb, s.k);
+          sites.push({ kind: "bang-call", callee: s.k,
+            argumentWords: sig.lays.map((l) => l.ks.length),
+            resultWords: sig.ret.ks.length });
+        }
+        return false;
+      });
+    }
+    return { kind: "def", name: k, parameters: sig.live.map((d, i) => ({
+      name: d[1], layout: lay_report(sig.lays[i]) })),
+      result: lay_report(sig.ret), sites };
+  });
+  return JSON.stringify({ schema: "bend-layout-v1", target: "native-C",
+    note: "Typed structural sites and compiler interface widths; not emitted task counts or runtime cost. Some sites may be dead or folded. Generic constructor nodes use symbolic field types.",
+    declarations }, null, 2) + "\n";
 }
 
