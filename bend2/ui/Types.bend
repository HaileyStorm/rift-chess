# Shared presentation boundary. Game legality remains in the frozen kernel.
# Accessor blocks are generated by `node bend2/tools/accessors.mjs`.
import Base
import ../graphics/Camera.bend as Camera
import ../graphics/Scene.bend as Scene

# showMoves: legal destination overlays (rules §10: optional, off by default).
# showShifts: legal Shift indicators (on by default). Neither changes legality.
type Preferences is Data:
  Preferences{mode: U32, layout: Bool, policy: U32, theme: U32, sound: Bool, volume: U32, view: Camera.View, showMoves: Bool, showShifts: Bool}

type Meta is Data:
  Meta{revision: U32, turn: Bool, inCheck: Bool, outcome: U32, offer: U32, canUndo: Bool, botPaused: Bool, recovery: Bool}

type Panels is Data:
  Panels{menu: U32, page: U32, notice: String, draftMode: U32, draftLayout: Bool, draftPolicy: U32}

type Snapshot is Data:
  Snapshot{frame: Scene.Frame, preferences: Preferences, meta: Meta, panels: Panels, legal: List<&2, U32>, history: List<&2, String>, mobile: Bool, focus: U32, moving: Bool, checking: Bool, staged: Bool}

type Rect is Data:
  Rect{x: U32, y: U32, width: U32, height: U32}

type Control is Data:
  Control{id: U32, label: String, bounds: Rect, enabled: Bool, active: Bool}

type Note is Data:
  Note{frequency: F32, duration: U32, wave: U32, gain: F32, delay: U32}

type Input is Data:
  PointerDown{x: U32, y: U32, button: U32, alt: Bool}
  PointerMove{x: U32, y: U32}
  PointerUp{x: U32, y: U32, button: U32}
  # Presented squares are picked by the Bend application from the frame the
  # player saw. Raw x/y remain available for uninterrupted orbit deltas.
  PresentedMove{x: U32, y: U32, square: U32}
  PresentedUp{x: U32, y: U32, button: U32, square: U32}
  Wheel{x: U32, y: U32, delta: F32}
  KeyInput{code: U32, down: Bool, alt: Bool, ctrl: Bool, shift: Bool}
  Activate{id: U32}
  SquareInput{square: U32, expected: U32}
  Tick{ms: U32}
  Resize{width: U32, height: U32}
  # Generic browser observations; the Bend controller alone chooses detail.
  QualityProbe{portrait: Bool, physicalEdge: U32, timingValid: Bool,
    sampleCount: U32, measuredScale: U32, mainP90Us: U32, workerP90Us: U32}
  FileText{text: String}
  PortError{kind: U32}

type Effect is Data:
  Store{slot: U32, text: String}
  Download{name: String, text: String}
  PickFile{}
  Sound{notes: List<&2, Note>}
  OpenUrl{url: String}
  Exit{}

def default_preferences() -> Preferences:
  Preferences{0, True{}, 0, 0, True{}, 28, Camera.default_view(), False{}, True{}}

# BEGIN GENERATED ACCESSORS: Preferences prefix=preferences_
def preferences_mode(s: Preferences) -> U32:
  match s:
    case Preferences{mode, _, _, _, _, _, _, _, _}: mode

def set_preferences_mode(s: Preferences, v: U32) -> Preferences:
  match s:
    case Preferences{mode, layout, policy, theme, sound, volume, view, showMoves, showShifts}: Preferences{v, layout, policy, theme, sound, volume, view, showMoves, showShifts}

