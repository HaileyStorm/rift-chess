+# A uniform mask is exactly a constant-opacity RGB stamp. Its ignored green/blue
+# bits do not force the general two-cursor path. Pixel/endpoint laws are unchanged.
+def draw_views(+target_depth: Nat, +target_size: U32,
+  +source_depth: Nat, +source_size: U32, +sx: U32, +sy: U32,
+  colors: Image, mask: Image, +opacity: U32, image: Image) -> Image:
+  match mask:
+    case Pix{coverage}:
+      ConstantStamp.start(target_depth,target_size,
+        ImageView.View{source_depth,source_size,sx,sy,colors},
+        MaskedLayer.effective(Color.red(coverage),opacity),image)
+    case Qua{tl,tr,bl,br}:
+      Kernel.start(target_depth,target_size,
+        ImageView.View{source_depth,source_size,sx,sy,colors},
+        ImageView.View{source_depth,source_size,sx,sy,Qua{tl,tr,bl,br}},opacity,image)
+
