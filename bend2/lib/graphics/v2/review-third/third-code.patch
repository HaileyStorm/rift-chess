+++ b/verify_third_delivery.py
@@ -0,0 +1,46 @@
+#!/usr/bin/env python3
+"""Verify every manifested third-pass payload file without touching source files.
+
+The manifest intentionally does not hash itself. Ignored compiler/scratch builds
+and optional extra local files are outside its inventory; they do not change the
+meaning of a successful check of all delivered bytes. Historical manifests retain
+their earlier scope. This verifier performs no network access or write operation.
+"""
+from __future__ import annotations
+import hashlib
+import json
+from pathlib import Path
+import sys
+
+
+def main() -> None:
+    """Check manifest paths, byte sizes and SHA-256, including baseline preservation."""
+    root = Path(__file__).resolve().parent
+    manifest_path = root / 'THIRD_PASS_MANIFEST.json'
+    manifest = json.loads(manifest_path.read_text())
+    errors = []
+    entries = manifest['files']
+    for relative, expected in entries.items():
+        path = root / relative
+        if Path(relative).is_absolute() or '..' in Path(relative).parts or not path.resolve().is_relative_to(root):
+            errors.append(f'Unsafe manifest path: {relative}')
+            continue
+        if not path.is_file():
+            errors.append(f'Missing file: {relative}')
+            continue
+        content = path.read_bytes()
+        if len(content) != expected['bytes'] or hashlib.sha256(content).hexdigest() != expected['sha256']:
+            errors.append(f'Changed file: {relative}')
+    previous = json.loads((root / 'review-third/input-hashes.json').read_text())
+    for relative, expected in previous.items():
+        path = root / relative
+        if not path.is_file() or hashlib.sha256(path.read_bytes()).hexdigest() != expected:
+            errors.append(f'Previous-delivery byte preservation failed: {relative}')
+    print(json.dumps({'ok': not errors, 'manifested_files': len(entries),
+                      'preserved_previous_files': len(previous), 'errors': errors}, indent=2))
+    if errors:
+        sys.exit(1)
+
+
+if __name__ == '__main__':
+    main()
