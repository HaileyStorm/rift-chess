+++ b/bend2/lib/graphics/v2/third/GlyphLayer.bend
@@ -0,0 +1,35 @@
+# DRAFT native-resolution positioned glyph groups on isolated PMA surfaces.
+# Shares existing Glyph.Mask/Placed metrics and signed bearings. No shaping,
+# implicit line layout, font selection, hinting or low-resolution upscaling.
+# Prepare once, then apply group opacity, recolor, halo, blend and image shifts.
+import Base
+import ../Glyph.bend as Glyph
+import ../Shapes.bend as Shapes
+import ../Rect.bend as Rect
+import ./PreparedSprite.bend as Cached
+import ./Premul.bend as P
+import ./Surface.bend as Surface
+
+# Convert already clipped/aligned legacy glyph coverage at the explicit boundary.
+def composite(patch: Cached.Patch,+depth: Nat,target: Image) -> Image:
+  match patch:
+    case Cached.Patch{patch_depth,size,bounds,colors,mask}:
+      Surface.merge_tree(depth,P.Over{},Surface.from_planes(depth,colors,mask),target)
+
+# Existing signed bearings are relative to the placed baseline/origin.
+def glyph(placed: Glyph.Placed,+depth: Nat,+size: U32,color: U32,clip: Rect.Box,target: Image) -> Image:
+  match placed:
+    case Glyph.Placed{x,y,Glyph.Mask{advance,left,top,source_depth,source_size,coverage}}:
+      composite(Cached.prepare(depth,size,source_depth,source_size,Glyph.translate(x,left),Glyph.translate(y,top),Pix{color},coverage,clip),depth,target)
+
+# Glyph order is preserved, including overlapping glyphs and negative bearings.
+def run(glyphs: List<&2,Glyph.Placed>,+depth: Nat,+size: U32,+color: U32,+clip: Rect.Box,target: Image) -> Image:
+  match glyphs:
+    case Nil{}: target
+    case Con{head,tail}: run(tail,depth,size,color,clip,glyph(head,depth,size,color,clip,target))
+
+# Return a reusable isolated group. Apply Surface.opacity AFTER this constructor
+# for true group opacity instead of per-glyph rounding or darkened overlaps.
+def prepare(glyphs: List<&2,Glyph.Placed>,+depth: Nat,color: U32,clip: Rect.Box) -> Surface.Surface:
+  +size = U32.shln(1,depth)
+  Surface.Surface{depth,size,run(glyphs,depth,size,color,clip,Pix{0})}
diff --git a/bend2/lib/graphics/v2/third/ImageShift.bend b/bend2/lib/graphics/v2/third/ImageShift.bend
new file mode 100644
--- /dev/null
+++ b/bend2/lib/graphics/v2/third/ImageShift.bend
@@ -0,0 +1,38 @@
+# DRAFT exact U32-word translation. Suitable for RGB, PMA and scalar-mask Images.
+# Outside pixels are zero; no blending, color conversion or alpha rounding occurs.
+import Base
+import ../ImageView.bend as View
+import ../ImageOps.bend as Ops
+import ../Shapes.bend as Shapes
+
+# Resolve a narrowed source only after its outside/alignment classification.
+def tree(+depth: Nat,+span: U32,+x: U32,+y: U32,outside: Bool,aligned: Bool,+view: View.View) -> Image:
+  match depth outside aligned:
+    case _ True{} _: Pix{0}
+    case _ False{} True{}: View.pixels(view)
+    case 0n False{} False{}: Pix{View.sample(view,x,y)}
+    case 1n+rest False{} False{}:
+      +h = U32.div(span,2)
+      +xx = U32.add(x,h)
+      +yy = U32.add(y,h)
+      +va = View.narrow(view,x,y,h)
+      +vb = View.narrow(view,xx,y,h)
+      +vc = View.narrow(view,x,yy,h)
+      +vd = View.narrow(view,xx,yy,h)
+      a = tree(rest,h,x,y,View.outside(va,x,y,h),View.matches(va,x,y,h),va)
+      b = tree(rest,h,xx,y,View.outside(vb,xx,y,h),View.matches(vb,xx,y,h),vb)
+      c = tree(rest,h,x,yy,View.outside(vc,x,yy,h),View.matches(vc,x,yy,h),vc)
+      d = tree(rest,h,xx,yy,View.outside(vd,xx,yy,h),View.matches(vd,xx,yy,h),vd)
+      Ops.quad(a,b,c,d)
+
+# Invalid signed coordinates are rejected as an all-zero image.
+def start(valid: Bool,+depth: Nat,+size: U32,view: View.View) -> Image:
+  match valid:
+    case False{}: Pix{0}
+    case True{}:
+      +v = View.narrow(view,4096,4096,size)
+      tree(depth,size,4096,4096,View.outside(v,4096,4096,size),View.matches(v,4096,4096,size),v)
+
+# Translate within a same-size square. Source/target extent is an explicit domain.
+def shift(+depth: Nat,+size: U32,image: Image,+left: Shapes.Coord,+top: Shapes.Coord) -> Image:
+  start(Bool.and(Shapes.valid_coord(left),Shapes.valid_coord(top)),depth,size,View.View{depth,size,Shapes.biased(left),Shapes.biased(top),image})
diff --git a/bend2/lib/graphics/v2/third/Paint.bend b/bend2/lib/graphics/v2/third/Paint.bend
new file mode 100644
--- /dev/null
+++ b/bend2/lib/graphics/v2/third/Paint.bend
@@ -0,0 +1,60 @@
+# DRAFT pure surface rasterization with prepared shape/brush inputs.
+# Brush sampled at pixel center; coverage quantized once then scales PMA once.
+# Source-over only here. Other blend/group modes are explicit Surface operations.
+import Base
+import ./Shape.bend as Shape
+import ./Brush.bend as Brush
+import ./Premul.bend as P
+import ./Surface.bend as Surface
+import ../Rect.bend as Rect
+import ../ImageOps.bend as Ops
+
+# Branch before gradient sampling; zero geometric coverage is exact target identity.
+def pixel(zero: Bool,coverage: U32,brush: Brush.Brush,x: U32,y: U32,target: Image) -> Image:
+  match zero target:
+    case True{} _: target
+    case False{} Pix{background}:
+      Pix{P.blend(P.Over{},P.scale(Brush.sample(brush,F32.add(U32.to_f32(x),0.5),F32.add(U32.to_f32(y),0.5)),coverage),background)}
+    case False{} Qua{a,b,c,d}: Qua{a,b,c,d}
+
+# True serial region; no parallel lets in this leaf kernel or its dependencies.
+def region(+depth: Nat,+span: U32,+x: U32,+y: U32,outside: Bool,
+  +shape: Shape.Shape,+brush: Brush.Brush,+quality: Shape.Quality,+clip: Rect.Box,+target: Image) -> Image:
+  match depth outside:
+    case _ True{}: target
+    case 0n False{}:
+      +coverage = Shape.coverage(shape,quality,x,y)
+      pixel(U32.is_zero(coverage),coverage,brush,x,y,target)
+    case 1n+rest False{}:
+      +h = U32.div(span,2)
+      +xx = U32.add(x,h)
+      +yy = U32.add(y,h)
+      a = region(rest,h,x,y,Bool.not(Rect.overlaps(clip,Rect.cell(x,y,h))),shape,brush,quality,clip,Ops.tl(target))
+      b = region(rest,h,xx,y,Bool.not(Rect.overlaps(clip,Rect.cell(xx,y,h))),shape,brush,quality,clip,Ops.tr(target))
+      c = region(rest,h,x,yy,Bool.not(Rect.overlaps(clip,Rect.cell(x,yy,h))),shape,brush,quality,clip,Ops.bl(target))
+      d = region(rest,h,xx,yy,Bool.not(Rect.overlaps(clip,Rect.cell(xx,yy,h))),shape,brush,quality,clip,Ops.br(target))
+      Ops.quad(a,b,c,d)
+
+# Bounded native forks above the same substantial serial kernel.
+def pool(+forks: Nat,+depth: Nat,+span: U32,+x: U32,+y: U32,outside: Bool,
+  +shape: Shape.Shape,+brush: Brush.Brush,+quality: Shape.Quality,+clip: Rect.Box,+target: Image) -> Image:
+  match forks depth outside:
+    case _ _ True{}: target
+    case 0n _ False{}: region(depth,span,x,y,False{},shape,brush,quality,clip,target)
+    case 1n+rest 0n False{}: region(depth,span,x,y,False{},shape,brush,quality,clip,target)
+    case 1n+rest 1n+lower False{}:
+      +h = U32.div(span,2)
+      +xx = U32.add(x,h)
+      +yy = U32.add(y,h)
+      a b c d = pool(rest,lower,h,x,y,Bool.not(Rect.overlaps(clip,Rect.cell(x,y,h))),shape,brush,quality,clip,Ops.tl(target))
+        pool(rest,lower,h,xx,y,Bool.not(Rect.overlaps(clip,Rect.cell(xx,y,h))),shape,brush,quality,clip,Ops.tr(target))
+        pool(rest,lower,h,x,yy,Bool.not(Rect.overlaps(clip,Rect.cell(x,yy,h))),shape,brush,quality,clip,Ops.bl(target))
+        pool(rest,lower,h,xx,yy,Bool.not(Rect.overlaps(clip,Rect.cell(xx,yy,h))),shape,brush,quality,clip,Ops.br(target))
+      Ops.quad(a,b,c,d)
+
+# Public same-size surface draw. The application chooses sampling and fork budget.
+def fill(surface: Surface.Surface,+shape: Shape.Shape,brush: Brush.Brush,quality: Shape.Quality,forks: Nat,clip: Rect.Box) -> Surface.Surface:
+  match surface:
+    case Surface.Surface{+depth,+size,pixels}:
+      +bounds = Rect.intersect(clip,Shape.bounds(shape))
+      Surface.Surface{depth,size,pool(forks,depth,size,0,0,Bool.not(Rect.overlaps(bounds,Rect.screen(size))),shape,brush,quality,bounds,pixels)}
diff --git a/bend2/lib/graphics/v2/third/PathFill.bend b/bend2/lib/graphics/v2/third/PathFill.bend
new file mode 100644
--- /dev/null
+++ b/bend2/lib/graphics/v2/third/PathFill.bend
@@ -0,0 +1,206 @@
+# DRAFT closed paths: half-open upward ray crossings, even-odd/nonzero winding.
+# Coordinates finite in [-4096,4096]. Polygon input <=1024 points. Curves use
+# explicitly bounded subdivision levels<=8; they are not analytic/tolerance paths.
+# Multiple contours combine by join(); choose the winding rule when sampling.
+import Base
+import ../../Quad.bend as Quad
+import ../Stroke.bend as Stroke
+import ../Rect.bend as Rect
+import ../RgbaAffine.bend as Affine
+import ./Brush.bend as Brush
+
+type Rule is Data:
+  EvenOdd{}
+  NonZero{}
+
+type Extent is Data:
+  Extent{left: F32,top: F32,right: F32,bottom: F32}
+
+type Edges is Data:
+  Empty{}
+  Edge{ax: F32,ay: F32,dx: F32,dy: F32,up: Bool,extent: Extent}
+  Join{left: Edges,right: Edges,extent: Extent}
+
+# Binary-carry forest records occupied empty-edge buckets separately from vacancies.
+# Thus horizontal edges cannot destroy the balancing invariant.
+type Forest is Data:
+  End{}
+  Vacant{tail: Forest}
+  Occupied{tree: Edges,tail: Forest}
+
+type Count is Data:
+  Count{up: U32,down: U32}
+
+# Read conservative bounds before testing individual ray crossings.
+def extent(edges: Edges) -> Extent:
+  match edges:
+    case Empty{}: Extent{0.0,0.0,0.0,0.0}
+    case Edge{ax,ay,dx,dy,up,extent}: extent
+    case Join{left,right,extent}: extent
+
+# Merge closed-contour edge sets without reversing or reordering their winding.
+def union_extent(a: Extent,b: Extent) -> Extent:
+  match a b:
+    case Extent{al,at,ar,ab} Extent{bl,bt,br,bb}:
+      Extent{F32.min(al,bl),F32.min(at,bt),F32.max(ar,br),F32.max(ab,bb)}
+
+# Empty nodes are identities; balanced curve subdivision retains balanced joins.
+def join(+left: Edges,+right: Edges) -> Edges:
+  match left right:
+    case Empty{} _: right
+    case _ Empty{}: left
+    case _ _: Join{left,right,union_extent(extent(left),extent(right))}
+
+# Store edges low-y to high-y while preserving original contour direction.
+def ordered(up: Bool,+ax: F32,+ay: F32,+bx: F32,+by: F32) -> Edges:
+  match up:
+    case True{}: Edge{ax,ay,F32.sub(bx,ax),F32.sub(by,ay),True{},Extent{F32.min(ax,bx),ay,F32.max(ax,bx),by}}
+    case False{}: Edge{bx,by,F32.sub(ax,bx),F32.sub(ay,by),False{},Extent{F32.min(ax,bx),by,F32.max(ax,bx),ay}}
+
+# Horizontal/degenerate edges do not participate in the half-open crossing count.
+def edge_case(valid: Bool,a: Quad.Point,b: Quad.Point) -> Edges:
+  match valid a b:
+    case False{} _ _: Empty{}
+    case True{} Quad.Point{ax,+ay} Quad.Point{bx,+by}: ordered(F32.is_lt(ay,by),ax,ay,bx,by)
+
+# Low-level segment preparation; high-level polygon validates the entire contour.
+def edge(+a: Quad.Point,+b: Quad.Point) -> Edges:
+  match a b:
+    case Quad.Point{+ax,+ay} Quad.Point{+bx,+by}:
+      edge_case(Bool.and(Bool.and(Brush.point(Quad.Point{ax,ay}),Brush.point(Quad.Point{bx,by})),F32.is_ne(ay,by)),Quad.Point{ax,ay},Quad.Point{bx,by})
+
+# Original linear contour accumulator, retained as a differential baseline.
+# Public polygon() now uses balanced() to avoid O(edge_count) traversal depth.
+def contour(points: List<&2,Quad.Point>,+first: Quad.Point,last: Quad.Point,edges: Edges) -> Edges:
+  match points:
+    case Nil{}: join(edges,edge(last,first))
+    case Con{+head,tail}: contour(tail,first,head,join(edges,edge(last,head)))
+
+# Append one contour edge with binary carries. Occupied buckets hold 2^k
+# consecutive source edges, so preparation is amortized linear and depth logarithmic.
+def push(forest: Forest,tree: Edges) -> Forest:
+  match forest:
+    case End{}: Occupied{tree,End{}}
+    case Vacant{tail}: Occupied{tree,tail}
+    case Occupied{previous,tail}: Vacant{push(tail,join(previous,tree))}
+
+# Low buckets contain later edges. Prepending higher buckets preserves source order.
+def finish(forest: Forest,edges: Edges) -> Edges:
+  match forest:
+    case End{}: edges
+    case Vacant{tail}: finish(tail,edges)
+    case Occupied{tree,tail}: finish(tail,join(tree,edges))
+
+# Build a balanced closed contour without sorting or altering any individual edge.
+def balanced(points: List<&2,Quad.Point>,+first: Quad.Point,last: Quad.Point,forest: Forest) -> Edges:
+  match points:
+    case Nil{}: finish(push(forest,edge(last,first)),Empty{})
+    case Con{+head,tail}: balanced(tail,first,head,push(forest,edge(last,head)))
+
+# Bound count and validate every input point before constructing any geometry.
+def valid(fuel: Nat,points: List<&2,Quad.Point>) -> Bool:
+  match fuel points:
+    case _ Nil{}: True{}
+    case 0n Con{head,tail}: False{}
+    case 1n+rest Con{head,tail}: Bool.and(Brush.point(head),valid(rest,tail))
+
+# Empty/one-point input produces an empty path, not a fabricated area.
+def polygon_case(ok: Bool,points: List<&2,Quad.Point>) -> Maybe<Edges>:
+  match ok points:
+    case False{} _: None{}
+    case True{} Nil{}: Some{Empty{}}
+    case True{} Con{+first,tail}: Some{balanced(tail,first,first,End{})}
+
+# Public checked closed polygon, including self-intersecting and compound usage.
+def polygon(+points: List<&2,Quad.Point>) -> Maybe<Edges>:
+  polygon_case(valid(1024n,points),points)
+
+# Fixed 2^levels quadratic pieces; caller closes the surrounding contour.
+def quadratic(+levels: Nat,+a: Quad.Point,+control: Quad.Point,+b: Quad.Point) -> Edges:
+  match levels:
+    case 0n: edge(a,b)
+    case 1n+rest:
+      +ac = Stroke.middle(a,control)
+      +cb = Stroke.middle(control,b)
+      +mid = Stroke.middle(ac,cb)
+      join(quadratic(rest,a,ac,mid),quadratic(rest,mid,cb,b))
+
+# Fixed 2^levels cubic pieces via de Casteljau subdivision.
+def cubic(+levels: Nat,+a: Quad.Point,+c1: Quad.Point,+c2: Quad.Point,+b: Quad.Point) -> Edges:
+  match levels:
+    case 0n: edge(a,b)
+    case 1n+rest:
+      +ab = Stroke.middle(a,c1)
+      +bc = Stroke.middle(c1,c2)
+      +cd = Stroke.middle(c2,b)
+      +abc = Stroke.middle(ab,bc)
+      +bcd = Stroke.middle(bc,cd)
+      +mid = Stroke.middle(abc,bcd)
+      join(cubic(rest,a,ab,abc,mid),cubic(rest,mid,bcd,cd,b))
+
+# Ray points outside the y interval or right of all edges can be skipped safely.
+def excluded(extent: Extent,+x: F32,+y: F32) -> Bool:
+  match extent:
+    case Extent{left,top,right,bottom}: Bool.or(Bool.or(F32.is_lt(y,top),F32.is_ge(y,bottom)),F32.is_ge(x,right))
+
+# Add signed crossing counts without a wrapping signed-int representation.
+def add(a: Count,b: Count) -> Count:
+  match a b:
+    case Count{au,ad} Count{bu,bd}: Count{U32.add(au,bu),U32.add(ad,bd)}
+
+# A strict cross-product test specifies the on-edge side; vertical extrema use
+# low-inclusive/high-exclusive y tests so vertices are never counted twice.
+def crossing(hit: Bool,up: Bool) -> Count:
+  match hit up:
+    case False{} _: Count{0,0}
+    case True{} True{}: Count{1,0}
+    case True{} False{}: Count{0,1}
+
+# Recursively cull edge ranges before evaluating the F32 cross product.
+def count(edges: Edges,outside: Bool,+x: F32,+y: F32) -> Count:
+  match edges outside:
+    case _ True{}: Count{0,0}
+    case Empty{} False{}: Count{0,0}
+    case Edge{ax,ay,dx,dy,up,extent} False{}:
+      crossing(F32.is_gt(F32.sub(F32.mul(dx,F32.sub(y,ay)),F32.mul(F32.sub(x,ax),dy)),0.0),up)
+    case Join{+left,+right,cached} False{}:
+      add(count(left,excluded(extent(left),x,y),x,y),count(right,excluded(extent(right),x,y),x,y))
+
+# Interpret winding independently from contour orientation/order.
+def decide(rule: Rule,value: Count) -> Bool:
+  match rule value:
+    case EvenOdd{} Count{up,down}: U32.is_ne(U32.mod(U32.add(up,down),2),0)
+    case NonZero{} Count{up,down}: U32.is_ne(up,down)
+
+# Point queries share the exact crossing rule used by raster coverage.
+def hit(+edges: Edges,rule: Rule,+x: F32,+y: F32) -> Bool:
+  decide(rule,count(edges,excluded(extent(edges),x,y),x,y))
+
+# Convert finite geometry bounds conservatively into screen-space pixel bounds.
+def screen_extent(extent: Extent) -> Rect.Box:
+  match extent:
+    case Extent{left,top,right,bottom}: Rect.Box{Affine.floor_bound(left),Affine.floor_bound(top),Affine.ceil_bound(right),Affine.ceil_bound(bottom)}
+
+# Empty geometry never forces a full-canvas raster pass.
+def bounds(edges: Edges) -> Rect.Box:
+  screen_extent(extent(edges))
+
+# Checked curve wrappers validate all controls and the complete subdivision budget.
+def checked_quadratic_case(ok: Bool,levels: Nat,a: Quad.Point,c: Quad.Point,b: Quad.Point) -> Maybe<Edges>:
+  match ok:
+    case False{}: None{}
+    case True{}: Some{quadratic(levels,a,c,b)}
+
+# Rejection is explicit instead of silently truncating an excessive level request.
+def checked_quadratic(+levels: Nat,+a: Quad.Point,+c: Quad.Point,+b: Quad.Point) -> Maybe<Edges>:
+  checked_quadratic_case(Bool.and(Nat.is_le(levels,8n),Bool.and(Brush.point(a),Bool.and(Brush.point(c),Brush.point(b)))),levels,a,c,b)
+
+# The unchecked kernel is reachable only after the public wrapper's complete check.
+def checked_cubic_case(ok: Bool,levels: Nat,a: Quad.Point,c1: Quad.Point,c2: Quad.Point,b: Quad.Point) -> Maybe<Edges>:
+  match ok:
+    case False{}: None{}
+    case True{}: Some{cubic(levels,a,c1,c2,b)}
+
+# Fixed subdivision is a visible approximation parameter, not an error tolerance.
+def checked_cubic(+levels: Nat,+a: Quad.Point,+c1: Quad.Point,+c2: Quad.Point,+b: Quad.Point) -> Maybe<Edges>:
+  checked_cubic_case(Bool.and(Nat.is_le(levels,8n),Bool.and(Bool.and(Brush.point(a),Brush.point(c1)),Bool.and(Brush.point(c2),Brush.point(b)))),levels,a,c1,c2,b)
diff --git a/bend2/lib/graphics/v2/third/PixelBuffer.bend b/bend2/lib/graphics/v2/third/PixelBuffer.bend
new file mode 100644
--- /dev/null
+++ b/bend2/lib/graphics/v2/third/PixelBuffer.bend
@@ -0,0 +1,43 @@
+# DRAFT exclusively owned Morton-order U32 buffers for preparation kernels.
+# Coordinates are 0..size-1, size=2^depth,depth<=12. Array indices wrap upstream;
+# index() interleaves at most 12 valid bits and never reaches outside allocation.
+# Morton ordering allows zero-copy array partitioning during Image conversion.
+import Base
+import ../ImageOps.bend as Ops
+
+# Spread the low sixteen bits into even positions; callers use at most twelve.
+def spread(value: U32) -> U32:
+  +a = U32.and(value,65535)
+  +b = U32.and(U32.or(a,U32.shln(a,8n)),16711935)
+  +c = U32.and(U32.or(b,U32.shln(b,4n)),252645135)
+  +d = U32.and(U32.or(c,U32.shln(c,2n)),858993459)
+  U32.and(U32.or(d,U32.shln(d,1n)),1431655765)
+
+# Morton index: x in even bits, y in odd bits, quadrants TL/TR/BL/BR.
+def index(x: U32,y: U32) -> U32:
+  U32.or(spread(x),U32.shln(spread(y),1n))
+
+# Expand immutable uniform pixels into an owned array of exactly 4^depth words.
+def from_image(+depth: Nat,image: Image) -> Array<U32>:
+  match depth image:
+    case _ Pix{pixel}: Array.new(U32,Nat.add(depth,depth),pixel)
+    case 0n Qua{a,b,c,d}: Array.new(U32,0n,0)
+    case 1n+rest Qua{a,b,c,d}:
+      aa = from_image(rest,a)
+      bb = from_image(rest,b)
+      cc = from_image(rest,c)
+      dd = from_image(rest,d)
+      ANode{ANode{aa,bb},ANode{cc,dd}}
+
+# Consume the owner while freezing into an immutable compact Image.
+# Malformed depth/storage pairs are outside the public domain.
+def image(+depth: Nat,buffer: Array<U32>) -> Image:
+  match depth buffer:
+    case 0n ALeaf{pixel}: Pix{pixel}
+    case 1n+rest ANode{ANode{a,b},ANode{c,d}}:
+      aa = image(rest,a)
+      bb = image(rest,b)
+      cc = image(rest,c)
+      dd = image(rest,d)
+      Ops.quad(aa,bb,cc,dd)
+    case _ _: Pix{0}
diff --git a/bend2/lib/graphics/v2/third/Premul.bend b/bend2/lib/graphics/v2/third/Premul.bend
new file mode 100644
--- /dev/null
+++ b/bend2/lib/graphics/v2/third/Premul.bend
@@ -0,0 +1,98 @@
+# DRAFT encoded-channel premultiplied RGBA, packed 0xAARRGGBB.
+# Separate from every legacy RGB Image/Color API. Canonical channels <= alpha.
+# No linear-light/HDR claim; transparent canonical value is exactly zero.
+import Base
+import ../Color.bend as Color
+
+type Mode is Data:
+  Over{}
+  Multiply{}
+  Screen{}
+  Plus{}
+  SourceIn{}
+  SourceOut{}
+  Atop{}
+  Xor{}
+
+# Read the independent alpha byte, never legacy Image high-bit garbage.
+def alpha(pixel: U32) -> U32:
+  U32.shrn(pixel,24n)
+
+# Round one nonnegative product divided by 255, with factors in 0..255.
+def mul(a: U32,b: U32) -> U32:
+  U32.div(U32.add(U32.mul(a,b),127),255)
+
+# Pack/clamp channels to alpha, establishing a canonical premultiplied word.
+def pack(r: U32,g: U32,b: U32,a: U32) -> U32:
+  +aa = U32.min(a,255)
+  U32.or(U32.shln(aa,24n),Color.rgb(U32.min(r,aa),U32.min(g,aa),U32.min(b,aa)))
+
+# Convert straight encoded RGB once; hidden RGB at alpha zero is discarded.
+def straight(+rgb: U32,opacity: U32) -> U32:
+  +a = U32.min(opacity,255)
+  pack(mul(Color.red(rgb),a),mul(Color.green(rgb),a),mul(Color.blue(rgb),a),a)
+
+# Detect malformed host-created words without silently treating them as straight.
+def valid(+pixel: U32) -> Bool:
+  +a = alpha(pixel)
+  Bool.and(Bool.and(U32.is_le(Color.red(pixel),a),U32.is_le(Color.green(pixel),a)),U32.is_le(Color.blue(pixel),a))
+
+# Scale both alpha and premultiplied channels; this is isolated group opacity.
+def scale(+pixel: U32,opacity: U32) -> U32:
+  +a = U32.min(opacity,255)
+  pack(mul(Color.red(pixel),a),mul(Color.green(pixel),a),mul(Color.blue(pixel),a),mul(alpha(pixel),a))
+
+# Canonical unpremultiplication, used only at a straight-alpha boundary.
+def unweight(zero: Bool,+pixel: U32,+a: U32) -> U32:
+  match zero:
+    case True{}: 0
+    case False{}:
+      Color.rgb(U32.min(255,U32.div(U32.add(U32.mul(Color.red(pixel),255),U32.div(a,2)),a)),
+        U32.min(255,U32.div(U32.add(U32.mul(Color.green(pixel),255),U32.div(a,2)),a)),
+        U32.min(255,U32.div(U32.add(U32.mul(Color.blue(pixel),255),U32.div(a,2)),a)))
+
+# Unpremultiplication cannot recover quantized low-alpha source channels.
+def rgb(+pixel: U32) -> U32:
+  unweight(U32.is_zero(alpha(pixel)),pixel,alpha(pixel))
+
+# Source-over alpha union, rounded once for the destination contribution.
+def union(+sa: U32,da: U32) -> U32:
+  U32.add(sa,mul(da,U32.sub(255,sa)))
+
+# One channel of the specified encoded-space blend; maximum numerator < 2^18.
+def channel(mode: Mode,+s: U32,+d: U32,+sa: U32,+da: U32) -> U32:
+  match mode:
+    case Over{}: U32.add(s,mul(d,U32.sub(255,sa)))
+    case Multiply{}:
+      U32.div(U32.add(U32.add(U32.mul(s,d),U32.add(U32.mul(s,U32.sub(255,da)),U32.mul(d,U32.sub(255,sa)))),127),255)
+    case Screen{}: U32.sub(U32.add(s,d),mul(s,d))
+    case Plus{}: U32.min(255,U32.add(s,d))
+    case SourceIn{}: mul(s,da)
+    case SourceOut{}: mul(s,U32.sub(255,da))
+    case Atop{}: U32.div(U32.add(U32.add(U32.mul(s,da),U32.mul(d,U32.sub(255,sa))),127),255)
+    case Xor{}: U32.div(U32.add(U32.add(U32.mul(s,U32.sub(255,da)),U32.mul(d,U32.sub(255,sa))),127),255)
+
+# Alpha equations are independent of RGB blend modes.
+def result_alpha(mode: Mode,+sa: U32,+da: U32) -> U32:
+  match mode:
+    case Over{}: union(sa,da)
+    case Multiply{}: union(sa,da)
+    case Screen{}: union(sa,da)
+    case Plus{}: U32.min(255,U32.add(sa,da))
+    case SourceIn{}: mul(sa,da)
+    case SourceOut{}: mul(sa,U32.sub(255,da))
+    case Atop{}: da
+    case Xor{}: U32.div(U32.add(U32.add(U32.mul(sa,U32.sub(255,da)),U32.mul(da,U32.sub(255,sa))),127),255)
+
+# Compose canonical words; final channel<=alpha clamping is part of this NEW API.
+def blend(+mode: Mode,+source: U32,+destination: U32) -> U32:
+  +sa = alpha(source)
+  +da = alpha(destination)
+  pack(channel(mode,Color.red(source),Color.red(destination),sa,da),
+    channel(mode,Color.green(source),Color.green(destination),sa,da),
+    channel(mode,Color.blue(source),Color.blue(destination),sa,da),result_alpha(mode,sa,da))
+
+# Tint a premultiplied word without unpremultiplication; alpha is unchanged.
+def tint(+pixel: U32,+color: U32) -> U32:
+  pack(mul(Color.red(pixel),Color.red(color)),mul(Color.green(pixel),Color.green(color)),
+    mul(Color.blue(pixel),Color.blue(color)),alpha(pixel))
diff --git a/bend2/lib/graphics/v2/third/PreparedSprite.bend b/bend2/lib/graphics/v2/third/PreparedSprite.bend
